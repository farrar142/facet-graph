// facet 창: 코어의 「창 > 패널 > 탭」 상태를 그리는 자세히 보기.
// 판단은 하지 않는다. 그릴 값은 Rust(코어)가 넣고, 사용자 입력은 콜백으로 넘긴다.
// 사용자에게 보이는 글자는 모두 `@tr()`로 감싼다(ADR-0007).

import { ListView, Button, AboutSlint, Palette } from "std-widgets.slint";

// 자세히 보기의 한 행. 코어가 만든 값을 그대로 그린다.
export struct Row {
    name: string,
    folder: bool,
    modified: string,
    kind: string,
    size: string,
    // 검색 결과 항목이 든 폴더 경로(폴더 목록에서는 비어 있다).
    location: string,
    // 내용 검색 결과 항목의 「일치」 열 글자(일치 수와 첫 일치 줄, 내용 검색 결과가 아니면 비어 있다).
    matches: string,
    // 선택한 항목인가.
    selected: bool,
    // 커서 항목인가(키보드가 가리키는 항목. 선택과 다르다).
    cursor: bool,
    // 잘라낸 항목인가(잘라내기 표시: 흐리게 그린다).
    cut: bool,
}

// 명령 팔레트의 한 줄. 이름과 단축키 글자는 Rust가 넣고, 지금 실행할 수 없으면 꺼진 채로 그린다.
export struct PaletteRow {
    name: string,
    shortcut: string,
    enabled: bool,
}

// 복사·이동 대상 선택 창의 줄 하나: 경로와 출처(반대편 패널 위치, 최근 대상, 친 글자의 자동 완성 후보). 출처의
// 이름 글자는 화면이 `@tr()`로 만든다.
export enum TargetSection { opposite, recent, completion }
export struct TargetRow {
    path: string,
    section: TargetSection,
}

// 목록 읽기나 기본 프로그램으로 열기가 실패한 까닭. 문장은 화면이 `@tr()`로 만든다.
export enum Problem {
    none,
    // 목록 읽기
    not-found,
    permission-denied,
    not-a-folder,
    io,
    // 기본 프로그램으로 열기
    no-association,
    path-too-long,
    open-unsupported,
    open-failed,
    // 주소창 글자 해석
    address-empty,
    address-invalid-character,
    address-undefined-variable,
    address-not-absolute,
    address-not-found,
    address-permission-denied,
    address-io,
}

// 탭 줄의 탭 하나: 제목(폴더 이름), 툴팁(전체 경로), 활성 탭인가. 이름과 경로라 번역하지 않는다.
// 사각형 선택 중 그릴 사각형: 보이는가, 목록 내용 기준 자리(목록 왼쪽과 첫 행 위가 0)와 크기.
export struct MarqueeBox {
    shown: bool,
    x: length,
    y: length,
    width: length,
    height: length,
}

export struct TabItem {
    title: string,
    path: string,
    active: bool,
}

// 패널 하나에 그릴 수치와 알림. 목록(행)·탭 줄·경로 조각은 따로 넘긴다(바뀔 때만 고쳐 화면 요소를 다시 만들지 않는다).
export struct PanelData {
    // 마지막 주소창 글자를 해석하지 못한 까닭과 값(글자·환경 변수 이름·경로)·자세한 내용. 탭은 원래 위치에 남는다.
    address-problem: Problem,
    address-problem-value: string,
    address-problem-detail: string,
    // 「읽는 중」을 드러내는가. 코어가 읽기를 시작하고 100ms가 지나면 참이다.
    reading: bool,
    // 마지막 이동(또는 새로 고침)이 실패한 까닭과 그 위치·자세한 내용. 탭은 원래 위치에 남는다.
    list-problem: Problem,
    list-problem-location: string,
    list-problem-detail: string,
    // 마지막으로 파일을 기본 프로그램으로 열지 못한 까닭.
    open-problem: Problem,
    open-problem-detail: string,
    // 「자동 새로 고침 안 됨」: 지금 위치에 변경 감시를 걸 수 없었다. F5로 새로 고친다.
    auto-refresh-off: bool,
    // 보던 위치가 사라져 옮겨 온 까닭: 0 없음, 1 상위 폴더로, 2 홈 폴더로. 사라진 위치도 함께 온다.
    relocation: int,
    relocation-vanished: string,
    // 정렬: 열(0 이름, 1 수정한 날짜, 2 유형, 3 크기)과 방향.
    sort-column: int,
    sort-descending: bool,
    // 상태 표시줄 수치. 선택한 파일 크기 합의 글자는 선택이 없으면 비어 있다.
    item-count: int,
    // 필터 중이면 필터 없이 보일 전체 항목 수, 아니면 -1.
    total-count: int,
    // 검색 결과 위치인가(위치 열을 보인다), 탐색 상태 띠 글자(비면 띠 없음), 탐색 중인가(중지 단추).
    results: bool,
    // 내용 검색 결과인가(「일치」 열을 보인다).
    content-results: bool,
    search-status: string,
    search-running: bool,
    selected-count: int,
    selected-size: string,
}

// 작업의 상태(코어의 `JobState`). 문장은 화면이 `@tr()`로 만든다.
export enum JobStatus { queued, running, paused, awaiting-answer, finished, failed, cancelled }

// 답을 기다리는 질문의 종류: 이름 충돌, 항목별 오류, 휴지통에 들어가지 않는 항목.
export enum JobAsk { none, conflict, error, not-recyclable }

// 작업의 종류(코어의 `JobKind`): 복사, 이동, 실행취소, 다시 실행, 삭제(휴지통), 영구 삭제.
export enum JobType { copy, move, undo, redo, recycle, delete, batch-rename }

// 이름 충돌 대화의 덮어쓰기 경고: 덮어쓸 수 없음(파일과 폴더), 덮어쓴 파일이 휴지통으로 감(되살릴 수 있음), 되살릴 수
// 없음(대상 위치에 휴지통이 없음).
export enum OverwriteNote { not-allowed, recyclable, permanent }

// 이름 충돌의 한 쪽 항목. 크기·수정 시각 글자는 자세히 보기와 같은 서식으로 Rust가 만든다(폴더면 크기는 비어 있다,
// 시각을 읽지 못했으면 비어 있다).
export struct ConflictSide {
    path: string,
    folder: bool,
    size: string,
    modified: string,
}

// 두 항목의 비교: 모름(값이 없거나 폴더), 같음, 원본 쪽, 대상 쪽.
export enum Compare { unknown, same, source, target }

// 항목별 오류의 까닭(코어의 `FileOpErrorKind`). 문장은 화면이 `@tr()`로 만든다.
export enum ErrorReason { locked, access-denied, disk-full, source-missing, other }

// 이름 충돌·항목별 오류 질문의 답.
export enum ConflictChoice { overwrite, overwrite-if-newer, keep-both, skip }
export enum ErrorChoice { retry, skip, skip-all, cancel-job }
// 휴지통에 들어가지 않는 항목 질문의 답.
export enum NotRecyclableChoice { delete, delete-all, skip, skip-all, cancel-job }

// 오른쪽 메뉴의 줄 하나: 이름, 단축키 글자(없으면 비어 있음), 켜졌는가, 표시(「✓」「▲」「▼」 또는 비어 있음), 구분선인가,
// 하위 메뉴를 여는 줄인가. 글자는 Rust의 문장 모듈이 만든다(코어의 메뉴 구성을 그대로 그린다).
export struct MenuRow {
    name: string,
    shortcut: string,
    enabled: bool,
    mark: string,
    separator: bool,
    submenu: bool,
}

// 작업 기록 보기의 줄 하나: 작업 이름, 끝낸·건너뛴 항목 수, 되돌릴 수 없으면 그 까닭(되돌릴 수 있으면 비어 있음).
// 글자는 Rust의 문장 모듈이 만든다.
export struct HistoryRow {
    name: string,
    completed: int,
    skipped: int,
    not-undoable: string,
}

// 작업 영역의 작업 하나: **진행 표시**에 그릴 값. 수치 글자(바이트·속도·남은 시간)는 Rust가 만든다.
export struct JobRow {
    // 작업 번호(단추를 누르면 Rust에 돌려준다).
    id: int,
    // 작업 종류.
    kind: JobType,
    // 대상 폴더. 실행취소·다시 실행은 되돌리는 항목이 있는 폴더, 삭제는 지우는 위치다.
    target: string,
    status: JobStatus,
    // 더 바뀌지 않는 마지막 상태(끝남·실패·취소)인가.
    terminal: bool,
    // 항목 수: 한 것/센 것. 다 세기 전(`counted`가 거짓)에는 센 것이 늘어난다.
    items-done: int,
    items-total: int,
    counted: bool,
    // 바이트: 한 것/센 것, 평균 속도(초당). 진행이 아직 없으면 속도는 비어 있다.
    bytes-done: string,
    bytes-total: string,
    speed: string,
    // 남은 시간. 비었으면 「계산 중」이다.
    remaining: string,
    // 지금 다루는 항목의 이름.
    current: string,
    // 결과가 왔다(닫을 수 있다). 끝낸·건너뛴·남은 항목 수.
    finished: bool,
    completed: int,
    skipped: int,
    left: int,
    // 끝난 작업이 하지 못한 항목들(경로와 까닭, Rust의 문장 모듈이 만든다). 없으면 비어 있고, 있으면 결과 아래에 한
    // 줄 더 보인다(실행취소·다시 실행이 밖의 변경으로 되돌리지 못한 항목 등).
    not-done: string,
    // 일괄 이름 바꾸기가 실패·취소로 끝나 바꾼 항목을 모두 원래 이름으로 되돌렸다.
    rolled-back: bool,
    // 답을 기다리는 질문(코어의 `JobQuestion`). 있으면 진행 표시 아래에 질문 대화가 붙는다.
    ask: JobAsk,
    // 이름 충돌: 두 항목, 어느 쪽이 더 새것·더 큰지, 덮어쓰기를 고를 수 있는지, 덮어쓰기 경고.
    // 휴지통에 들어가지 않는 항목: 그 항목은 `source`다.
    source: ConflictSide,
    target-item: ConflictSide,
    newer: Compare,
    larger: Compare,
    can-overwrite: bool,
    overwrite-note: OverwriteNote,
    // 항목별 오류: 원본 경로와 까닭.
    error-path: string,
    error-reason: ErrorReason,
}

// 복사·이동 확인 줄에서 시작 전에 막힌 까닭(코어의 `CopyRejection`). 문장은 화면이 `@tr()`로 만든다.
export enum TransferProblem { none, no-sources, target-missing, target-not-folder, into-itself, target-inside-source, nothing-to-delete }

// 삭제 확인 줄의 까닭(코어의 `DeleteWarning`): 확인 줄이 복사·이동이면 none, 영구 삭제(Shift+Delete), 휴지통이 없는 위치의
// 삭제(Delete).
export enum DeleteConfirm { none, permanent, no-recycle-bin }

// 작은 단추: 진행 표시와 확인 줄에 쓴다. 눌러도 키보드 입력을 가져가지 않는다(창이 목록으로 돌린다).
component SmallButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    width: label.preferred-width + 16px;
    height: 22px;
    border-radius: 3px;
    border-width: 1px;
    border-color: Palette.border;
    background: touch.pressed ? Palette.selection-background
        : touch.has-hover ? Palette.alternate-background : Palette.control-background;
    label := Text {
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Palette.foreground;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// 질문 대화의 선택지 단추. 키보드로 고른 선택지(`current`)는 강조 테두리로 드러난다. 꺼져 있으면 흐리고 눌리지 않는다.
component ChoiceButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> current;
    callback clicked();
    width: label.preferred-width + 20px;
    height: 24px;
    border-radius: 3px;
    border-width: root.current ? 2px : 1px;
    border-color: root.current ? Palette.accent-background : Palette.border;
    background: !root.enabled ? Palette.alternate-background
        : touch.pressed ? Palette.selection-background
        : touch.has-hover ? Palette.alternate-background : Palette.control-background;
    label := Text {
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.enabled ? Palette.foreground : Palette.foreground.transparentize(65%);
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// 질문 대화의 확인란(「나머지에도 적용」 등).
component ChoiceCheck inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> current;
    callback toggled();
    width: box.width + label.preferred-width + 14px;
    height: 24px;
    border-radius: 3px;
    border-width: root.current ? 2px : 0px;
    border-color: Palette.accent-background;
    box := Rectangle {
        x: 4px;
        width: 14px;
        height: 14px;
        border-radius: 2px;
        border-width: 1px;
        border-color: root.checked ? Palette.accent-background : Palette.border;
        background: root.checked ? Palette.accent-background : Palette.control-background;
        Text {
            text: root.checked ? "✓" : "";
            color: Palette.accent-foreground;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    label := Text {
        x: box.x + box.width + 6px;
        text: root.text;
        vertical-alignment: center;
        color: Palette.foreground;
    }
    TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

// 질문 대화의 키보드 도움말.
component QuestionHint inherits Text {
    text: @tr("Tab·←→로 고르고 Enter, Esc는 목록으로");
    horizontal-stretch: 1;
    horizontal-alignment: right;
    vertical-alignment: center;
    overflow: elide;
    color: Palette.foreground.transparentize(45%);
}

// **이름 충돌 질문 대화**: 원본과 대상의 경로·크기·수정 시각을 나란히 보이고(더 새것·더 큰 쪽을 드러냄) 덮어쓰기·더 새것만
// 덮어쓰기·둘 다 유지·건너뛰기와 「나머지에도 적용」으로 답한다. 덮어쓰기 선택지 위에 덮어쓴 파일이 어떻게 되는지 늘 보인다:
// 대상 위치에 휴지통이 있으면 휴지통으로 가 실행취소로 되살릴 수 있고, 없으면 되살릴 수 없다.
// 파일과 폴더가 부딪히면 덮어쓰기 계열은 꺼져 있다.
//
// 키보드: 대화에 포커스가 있으면 Tab·Shift+Tab·←→로 선택지를 고르고 Enter·Space로 누른다. Esc는 아무 답도 하지 않고
// 목록으로 키보드를 돌린다(`leave`). 처음 고른 선택지는 잃는 것이 없는 「건너뛰기」다.
component ConflictQuestion inherits FocusScope {
    in property <JobRow> job;
    // 생길 때 키보드 포커스를 가져갈지(다른 입력란이 열려 있지 않을 때).
    in property <bool> autofocus;
    callback answer(ConflictChoice, bool);
    callback leave();
    // 「나머지에도 적용」.
    in-out property <bool> rest;
    // 키보드로 고른 선택지: 0 덮어쓰기, 1 더 새것만 덮어쓰기, 2 둘 다 유지, 3 건너뛰기, 4 나머지에도 적용.
    in-out property <int> choice: 3;

    function usable(i: int) -> bool {
        return i >= 2 || root.job.can-overwrite;
    }
    // 꺼진 선택지(0·1)를 건너뛰며 `d` 방향으로 하나 옮긴다.
    function step(d: int) {
        let a = Math.mod(root.choice + d + 5, 5);
        let b = root.usable(a) ? a : Math.mod(a + d + 5, 5);
        root.choice = root.usable(b) ? b : Math.mod(b + d + 5, 5);
    }
    function press(i: int) {
        if (i == 4) {
            root.rest = !root.rest;
        } else if (root.usable(i)) {
            root.answer(
                i == 0 ? ConflictChoice.overwrite
                    : i == 1 ? ConflictChoice.overwrite-if-newer
                    : i == 2 ? ConflictChoice.keep-both : ConflictChoice.skip,
                root.rest);
        }
    }

    init => {
        if (root.autofocus) {
            self.focus();
        }
    }
    key-pressed(event) => {
        if (event.text == Key.Escape) {
            root.leave();
        } else if (event.text == Key.Backtab || event.text == Key.LeftArrow
            || (event.text == Key.Tab && event.modifiers.shift)) {
            root.step(-1);
        } else if (event.text == Key.Tab || event.text == Key.RightArrow) {
            root.step(1);
        } else if (event.text == Key.Return || event.text == " ") {
            root.press(root.choice);
        }
        accept
    }

    Rectangle {
        border-width: 1px;
        border-radius: 3px;
        border-color: root.has-focus ? Palette.accent-background : #c42b1c;
        background: #fde7e9.transparentize(40%);
        TouchArea {
            clicked => {
                root.focus();
            }
        }
        VerticalLayout {
            padding: 6px;
            spacing: 3px;
            Text {
                text: root.job.can-overwrite ? @tr("이름 충돌: 대상 폴더에 같은 이름의 항목이 있습니다")
                    : @tr("이름 충돌: 같은 이름의 파일과 폴더가 부딪힙니다(덮어쓸 수 없습니다)");
                font-weight: 700;
                overflow: elide;
            }
            GridLayout {
                spacing-horizontal: 12px;
                spacing-vertical: 1px;
                Row {
                    Text {
                        text: @tr("원본");
                        color: Palette.foreground.transparentize(30%);
                    }
                    Text {
                        text: root.job.source.path;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: root.job.source.folder ? @tr("폴더") : root.job.source.size;
                        horizontal-alignment: right;
                        font-weight: root.job.larger == Compare.source ? 700 : 400;
                    }
                    Text {
                        text: root.job.source.modified;
                        font-weight: root.job.newer == Compare.source ? 700 : 400;
                    }
                    Text {
                        text: root.job.newer == Compare.source && root.job.larger == Compare.source ? @tr("더 새것 · 더 큼")
                            : root.job.newer == Compare.source ? @tr("더 새것")
                            : root.job.larger == Compare.source ? @tr("더 큼") : "";
                        color: Palette.accent-background;
                    }
                }
                Row {
                    Text {
                        text: @tr("대상");
                        color: Palette.foreground.transparentize(30%);
                    }
                    Text {
                        text: root.job.target-item.path;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: root.job.target-item.folder ? @tr("폴더") : root.job.target-item.size;
                        horizontal-alignment: right;
                        font-weight: root.job.larger == Compare.target ? 700 : 400;
                    }
                    Text {
                        text: root.job.target-item.modified;
                        font-weight: root.job.newer == Compare.target ? 700 : 400;
                    }
                    Text {
                        text: root.job.newer == Compare.target && root.job.larger == Compare.target ? @tr("더 새것 · 더 큼")
                            : root.job.newer == Compare.target ? @tr("더 새것")
                            : root.job.larger == Compare.target ? @tr("더 큼") : "";
                        color: Palette.accent-background;
                    }
                }
            }
            Text {
                text: root.job.overwrite-note == OverwriteNote.not-allowed ? @tr("파일과 폴더는 서로 덮어쓸 수 없습니다. 둘 다 유지나 건너뛰기로 답하세요")
                    : root.job.overwrite-note == OverwriteNote.permanent ? @tr("덮어쓰기: 덮어쓴 대상 파일은 되살릴 수 없습니다(영구 삭제)")
                    : @tr("덮어쓰기: 덮어쓴 대상 파일은 휴지통으로 가고 실행취소로 되살릴 수 있습니다");
                color: root.job.overwrite-note == OverwriteNote.recyclable ? Palette.foreground.transparentize(30%) : #c42b1c;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                ChoiceButton {
                    text: @tr("덮어쓰기");
                    enabled: root.job.can-overwrite;
                    current: root.has-focus && root.choice == 0;
                    clicked => {
                        root.press(0);
                    }
                }
                ChoiceButton {
                    text: @tr("더 새것만 덮어쓰기");
                    enabled: root.job.can-overwrite;
                    current: root.has-focus && root.choice == 1;
                    clicked => {
                        root.press(1);
                    }
                }
                ChoiceButton {
                    text: @tr("둘 다 유지");
                    current: root.has-focus && root.choice == 2;
                    clicked => {
                        root.press(2);
                    }
                }
                ChoiceButton {
                    text: @tr("건너뛰기");
                    current: root.has-focus && root.choice == 3;
                    clicked => {
                        root.press(3);
                    }
                }
                ChoiceCheck {
                    text: @tr("나머지에도 적용");
                    checked: root.rest;
                    current: root.has-focus && root.choice == 4;
                    toggled => {
                        root.rest = !root.rest;
                        root.focus();
                    }
                }
                QuestionHint { }
            }
        }
    }
}

// **항목별 오류 질문 대화**: 항목별 오류의 원본 경로와 까닭(디스크 가득 참이면 공간을 비운 뒤 다시 시도하라는 안내)을 보이고 다시
// 시도·건너뛰기·나머지 오류도 건너뛰기·작업 취소로 답한다. 키보드는 이름 충돌 질문 대화와 같다. 처음 고른 선택지는 「다시
// 시도」다.
component ErrorQuestion inherits FocusScope {
    in property <JobRow> job;
    in property <bool> autofocus;
    callback answer(ErrorChoice);
    callback leave();
    // 키보드로 고른 선택지: 0 다시 시도, 1 건너뛰기, 2 나머지 오류도 건너뛰기, 3 작업 취소.
    in-out property <int> choice: 0;

    function press(i: int) {
        root.answer(i == 0 ? ErrorChoice.retry : i == 1 ? ErrorChoice.skip : i == 2 ? ErrorChoice.skip-all : ErrorChoice.cancel-job);
    }

    init => {
        if (root.autofocus) {
            self.focus();
        }
    }
    key-pressed(event) => {
        if (event.text == Key.Escape) {
            root.leave();
        } else if (event.text == Key.Backtab || event.text == Key.LeftArrow
            || (event.text == Key.Tab && event.modifiers.shift)) {
            root.choice = Math.mod(root.choice + 3, 4);
        } else if (event.text == Key.Tab || event.text == Key.RightArrow) {
            root.choice = Math.mod(root.choice + 1, 4);
        } else if (event.text == Key.Return || event.text == " ") {
            root.press(root.choice);
        }
        accept
    }

    Rectangle {
        border-width: 1px;
        border-radius: 3px;
        border-color: root.has-focus ? Palette.accent-background : #c42b1c;
        background: #fde7e9.transparentize(40%);
        TouchArea {
            clicked => {
                root.focus();
            }
        }
        VerticalLayout {
            padding: 6px;
            spacing: 3px;
            Text {
                text: root.job.error-reason == ErrorReason.locked ? @tr("오류: 다른 프로그램이 이 항목을 쓰고 있습니다(잠김)")
                    : root.job.error-reason == ErrorReason.access-denied ? @tr("오류: 접근이 거부되었습니다")
                    : root.job.error-reason == ErrorReason.disk-full ? @tr("오류: 디스크가 가득 찼습니다")
                    : root.job.error-reason == ErrorReason.source-missing ? @tr("오류: 원본이 없습니다")
                    : @tr("오류: 이 항목을 처리하지 못했습니다");
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.job.error-path;
                overflow: elide;
            }
            Text {
                text: root.job.error-reason == ErrorReason.disk-full ? @tr("공간을 비운 뒤 다시 시도하면 이 항목부터 이어 갑니다") : "";
                color: Palette.foreground.transparentize(30%);
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                ChoiceButton {
                    text: @tr("다시 시도");
                    current: root.has-focus && root.choice == 0;
                    clicked => {
                        root.press(0);
                    }
                }
                ChoiceButton {
                    text: @tr("건너뛰기");
                    current: root.has-focus && root.choice == 1;
                    clicked => {
                        root.press(1);
                    }
                }
                ChoiceButton {
                    text: @tr("나머지 오류도 건너뛰기");
                    current: root.has-focus && root.choice == 2;
                    clicked => {
                        root.press(2);
                    }
                }
                ChoiceButton {
                    text: @tr("작업 취소");
                    current: root.has-focus && root.choice == 3;
                    clicked => {
                        root.press(3);
                    }
                }
                QuestionHint { }
            }
        }
    }
}

// **휴지통에 들어가지 않는 항목 질문 대화**: 휴지통 삭제에서 셸이 휴지통 대신 영구 삭제하려 한 항목(휴지통보다 큼, 휴지통을 끈
// 볼륨 등)의 경로·크기·수정 시각을 보이고, 아직 지우지 않았음과 영구 삭제하면 되살릴 수 없음을 알린다. 영구 삭제·나머지도
// 영구 삭제·건너뛰기·나머지도 건너뛰기·작업 취소로 답한다. 키보드는 이름 충돌 질문 대화와 같고, 처음 고른 선택지는 잃는 것이
// 없는 「건너뛰기」다.
component NotRecyclableQuestion inherits FocusScope {
    in property <JobRow> job;
    in property <bool> autofocus;
    callback answer(NotRecyclableChoice);
    callback leave();
    // 키보드로 고른 선택지: 0 영구 삭제, 1 나머지도 영구 삭제, 2 건너뛰기, 3 나머지도 건너뛰기, 4 작업 취소.
    in-out property <int> choice: 2;

    function press(i: int) {
        root.answer(i == 0 ? NotRecyclableChoice.delete
            : i == 1 ? NotRecyclableChoice.delete-all
            : i == 2 ? NotRecyclableChoice.skip
            : i == 3 ? NotRecyclableChoice.skip-all : NotRecyclableChoice.cancel-job);
    }

    init => {
        if (root.autofocus) {
            self.focus();
        }
    }
    key-pressed(event) => {
        if (event.text == Key.Escape) {
            root.leave();
        } else if (event.text == Key.Backtab || event.text == Key.LeftArrow
            || (event.text == Key.Tab && event.modifiers.shift)) {
            root.choice = Math.mod(root.choice + 4, 5);
        } else if (event.text == Key.Tab || event.text == Key.RightArrow) {
            root.choice = Math.mod(root.choice + 1, 5);
        } else if (event.text == Key.Return || event.text == " ") {
            root.press(root.choice);
        }
        accept
    }

    Rectangle {
        border-width: 1px;
        border-radius: 3px;
        border-color: root.has-focus ? Palette.accent-background : #c42b1c;
        background: #fde7e9.transparentize(40%);
        TouchArea {
            clicked => {
                root.focus();
            }
        }
        VerticalLayout {
            padding: 6px;
            spacing: 3px;
            Text {
                text: @tr("휴지통에 들어가지 않는 항목입니다(휴지통보다 크거나 휴지통을 쓰지 않는 위치). 아직 지우지 않았습니다");
                font-weight: 700;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.job.source.path;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: root.job.source.folder ? @tr("폴더") : root.job.source.size;
                    horizontal-alignment: right;
                }
                Text {
                    text: root.job.source.modified;
                }
            }
            Text {
                text: @tr("영구 삭제로 진행하면 이 항목은 되살릴 수 없습니다(실행취소할 수 없음)");
                color: #c42b1c;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                ChoiceButton {
                    text: @tr("영구 삭제");
                    current: root.has-focus && root.choice == 0;
                    clicked => {
                        root.press(0);
                    }
                }
                ChoiceButton {
                    text: @tr("나머지도 영구 삭제");
                    current: root.has-focus && root.choice == 1;
                    clicked => {
                        root.press(1);
                    }
                }
                ChoiceButton {
                    text: @tr("건너뛰기");
                    current: root.has-focus && root.choice == 2;
                    clicked => {
                        root.press(2);
                    }
                }
                ChoiceButton {
                    text: @tr("나머지도 건너뛰기");
                    current: root.has-focus && root.choice == 3;
                    clicked => {
                        root.press(3);
                    }
                }
                ChoiceButton {
                    text: @tr("작업 취소");
                    current: root.has-focus && root.choice == 4;
                    clicked => {
                        root.press(4);
                    }
                }
                QuestionHint { }
            }
        }
    }
}

// **진행 표시**: 작업 영역의 작업 하나. 종류·대상·상태와 단추, 그 아래 항목 수·바이트·속도·남은 시간·지금 파일,
// 끝났으면 결과(끝낸·건너뛴·남은 항목 수).
component JobView inherits Rectangle {
    in property <JobRow> job;
    callback pause();
    callback resume();
    callback cancel();
    callback start-now();
    callback dismiss();
    // 질문 대화: 생길 때 포커스를 가져갈지, 답, Esc.
    in property <bool> autofocus;
    callback answer-conflict(ConflictChoice, bool);
    callback answer-error(ErrorChoice);
    callback answer-not-recyclable(NotRecyclableChoice);
    callback leave();

    border-width: 1px;
    border-radius: 4px;
    border-color: Palette.border;
    background: Palette.background;
    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.job.kind == JobType.undo ? @tr("실행취소: {}", root.job.target)
                    : root.job.kind == JobType.redo ? @tr("다시 실행: {}", root.job.target)
                    : root.job.kind == JobType.recycle ? @tr("삭제: {}", root.job.target)
                    : root.job.kind == JobType.delete ? @tr("영구 삭제: {}", root.job.target)
                    : root.job.kind == JobType.batch-rename ? @tr("일괄 이름 바꾸기: {}", root.job.target)
                    : root.job.kind == JobType.move ? @tr("이동 → {}", root.job.target) : @tr("복사 → {}", root.job.target);
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
                font-weight: 700;
            }
            Text {
                text: root.job.status == JobStatus.queued ? @tr("대기 중")
                    : root.job.status == JobStatus.running ? @tr("실행 중")
                    : root.job.status == JobStatus.paused ? @tr("일시정지")
                    : root.job.status == JobStatus.awaiting-answer ? @tr("답을 기다림")
                    : root.job.status == JobStatus.finished ? @tr("끝남")
                    : root.job.status == JobStatus.failed ? @tr("끝남(건너뛴 오류 있음)")
                    : @tr("취소됨");
                vertical-alignment: center;
                color: root.job.status == JobStatus.failed || root.job.status == JobStatus.awaiting-answer ? #c42b1c
                    : Palette.foreground.transparentize(30%);
            }
            if root.job.status == JobStatus.queued: SmallButton {
                text: @tr("지금 시작");
                clicked => {
                    root.start-now();
                }
            }
            if root.job.status == JobStatus.queued || root.job.status == JobStatus.running: SmallButton {
                text: @tr("일시정지");
                clicked => {
                    root.pause();
                }
            }
            if root.job.status == JobStatus.paused: SmallButton {
                text: @tr("이어하기");
                clicked => {
                    root.resume();
                }
            }
            if !root.job.terminal: SmallButton {
                text: @tr("취소");
                clicked => {
                    root.cancel();
                }
            }
            if root.job.finished: SmallButton {
                text: @tr("닫기");
                clicked => {
                    root.dismiss();
                }
            }
        }
        if !root.job.finished: HorizontalLayout {
            spacing: 14px;
            Text {
                text: root.job.counted ? @tr("{} / {} 항목", root.job.items-done, root.job.items-total)
                    : @tr("{} / {}+ 항목", root.job.items-done, root.job.items-total);
                color: Palette.foreground.transparentize(30%);
            }
            Text {
                text: @tr("{} / {}", root.job.bytes-done, root.job.bytes-total);
                color: Palette.foreground.transparentize(30%);
            }
            if root.job.speed != "": Text {
                text: @tr("{}/초", root.job.speed);
                color: Palette.foreground.transparentize(30%);
            }
            Text {
                text: root.job.remaining == "" ? @tr("남은 시간: 계산 중") : @tr("남은 시간: {}", root.job.remaining);
                color: Palette.foreground.transparentize(30%);
            }
            Text {
                text: root.job.current;
                horizontal-stretch: 1;
                overflow: elide;
                color: Palette.foreground.transparentize(30%);
            }
        }
        if root.job.finished: Text {
            text: root.job.kind == JobType.undo ? @tr("되돌린 항목 {} · 못 한 항목 {} · 남은 항목 {}", root.job.completed, root.job.skipped, root.job.left)
                : root.job.kind == JobType.redo ? @tr("다시 한 항목 {} · 못 한 항목 {} · 남은 항목 {}", root.job.completed, root.job.skipped, root.job.left)
                : root.job.kind == JobType.batch-rename && root.job.rolled-back ? @tr("모두 되돌림")
                : root.job.kind == JobType.batch-rename ? @tr("바꿈 {} · 건너뜀 {}", root.job.completed, root.job.skipped)
                : @tr("끝낸 항목 {} · 건너뛴 항목 {} · 남은 항목 {}", root.job.completed, root.job.skipped, root.job.left);
            overflow: elide;
            color: Palette.foreground.transparentize(30%);
        }
        if root.job.not-done != "": Text {
            text: @tr("못 한 항목: {}", root.job.not-done);
            overflow: elide;
            color: #c42b1c;
        }
        if root.job.ask == JobAsk.conflict: ConflictQuestion {
            vertical-stretch: 1;
            job: root.job;
            autofocus: root.autofocus;
            answer(choice, rest) => {
                root.answer-conflict(choice, rest);
            }
            leave => {
                root.leave();
            }
        }
        if root.job.ask == JobAsk.error: ErrorQuestion {
            vertical-stretch: 1;
            job: root.job;
            autofocus: root.autofocus;
            answer(choice) => {
                root.answer-error(choice);
            }
            leave => {
                root.leave();
            }
        }
        if root.job.ask == JobAsk.not-recyclable: NotRecyclableQuestion {
            vertical-stretch: 1;
            job: root.job;
            autofocus: root.autofocus;
            answer(choice) => {
                root.answer-not-recyclable(choice);
            }
            leave => {
                root.leave();
            }
        }
    }
}

// 열 머리글 한 칸. 누르면 정렬하고, 오른쪽 경계를 끌어 너비를 바꾼다.
component Header inherits Rectangle {
    in property <string> text;
    in property <bool> sorted;
    in property <bool> descending;
    in property <bool> right-aligned;
    in-out property <length> column-width;
    callback sort();

    width: self.column-width;
    TouchArea {
        clicked => {
            root.sort();
        }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 4px;
        alignment: root.right-aligned ? LayoutAlignment.end : LayoutAlignment.start;
        Text {
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
            color: Palette.foreground.transparentize(30%);
        }
        if root.sorted: Text {
            text: root.descending ? "▼" : "▲";
            font-size: 9px;
            vertical-alignment: center;
            color: Palette.foreground.transparentize(30%);
        }
    }
    // 열 경계: 끌어서 너비를 바꾼다.
    Rectangle {
        x: parent.width - 4px;
        width: 8px;
        Rectangle {
            x: 3px;
            width: 1px;
            y: 4px;
            height: parent.height - 8px;
            background: Palette.border;
        }
        TouchArea {
            mouse-cursor: col-resize;
            moved => {
                if (self.pressed) {
                    root.column-width = max(40px, root.column-width + self.mouse-x - self.pressed-x);
                }
            }
        }
    }
}

// 내장 아이콘 두 가지: 폴더와 파일. 파일 종류별 아이콘은 S10이다.
component ItemIcon inherits Rectangle {
    in property <bool> folder;
    width: 16px;
    height: 16px;
    if root.folder: Rectangle {
        Rectangle {
            x: 1px;
            y: 2px;
            width: 6px;
            height: 3px;
            border-radius: 1px;
            background: #d9a521;
        }
        Rectangle {
            x: 1px;
            y: 4px;
            width: 14px;
            height: 10px;
            border-radius: 1px;
            background: #f2c94c;
        }
    }
    if !root.folder: Rectangle {
        x: 3px;
        y: 1px;
        width: 10px;
        height: 14px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8a8a8a;
        Rectangle {
            x: parent.width - 4px;
            y: 0px;
            width: 4px;
            height: 4px;
            background: #c8c8c8;
        }
    }
}

// 주소창의 경로 조각 하나. 누르면 그 위치로 간다.
component Segment inherits Rectangle {
    in property <string> text;
    // 끌어 온 항목이 놓일 조각인가(강조색).
    in property <bool> drop-target;
    callback pressed();
    // 조각의 창 기준 가로 자리가 바뀌었다(끌어 놓을 자리 판정에 쓴다).
    callback geometry(length, length);

    border-radius: 3px;
    background: root.drop-target ? Palette.accent-background.transparentize(60%) : touch.has-hover ? Palette.alternate-background : transparent;
    init => {
        root.geometry(self.absolute-position.x, self.width);
    }
    changed absolute-position => {
        root.geometry(self.absolute-position.x, self.width);
    }
    changed width => {
        root.geometry(self.absolute-position.x, self.width);
    }
    touch := TouchArea {
        clicked => {
            root.pressed();
        }
    }
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        Text {
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// 필터 입력란. 한글 IME의 조합 글자와 후보 창은 TextInput이 처리한다. 열릴 때와 `focus-count`가 바뀔 때(명령을 또
// 눌렀다) 포커스를 받고 전체를 선택한다.
component FilterBar inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <int> focus-count;
    callback edited(string);
    callback escape();

    height: 28px;
    background: Palette.background;
    border-width: 1px;
    border-radius: 3px;
    border-color: Palette.accent-background;
    clip: true;

    input := TextInput {
        x: 6px;
        width: parent.width - 12px;
        single-line: true;
        vertical-alignment: center;
        color: Palette.foreground;
        init => {
            self.focus();
            self.select-all();
        }
        edited => {
            root.edited(self.text);
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.escape();
                return accept;
            }
            reject
        }
    }

    changed focus-count => {
        input.focus();
        input.select-all();
    }
}

// 검색창: 글자를 쳐 Enter로 현재 폴더 아래 검색을 시작한다. 「이름」「내용」 전환이 있다. 「이름」이면 이름을 실시간으로
// 찾고, 「내용」이면 찾을 글자·파일 이름 조건·정규식 확인란이 보여 파일 안의 글자를 찾는다. 한글 IME의 조합 글자는
// TextInput이 처리하고 Enter가 확정한다(타자마다 시작하지 않는다). 열릴 때와 `focus-count`가 바뀔 때(명령을 또 눌렀다)
// 포커스를 받고 전체를 선택한다. 시작하지 못한 까닭(`problem`, 틀린 정규식 등)은 줄 아래에 보인다.
component SearchBar inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <int> focus-count;
    // 「내용」 검색인가, 정규식인가, 파일 이름 조건, 시작하지 못한 까닭(비면 없음).
    in-out property <bool> content;
    in-out property <bool> regex;
    in-out property <string> names <=> names-input.text;
    in property <string> problem;
    callback submit(string);
    callback escape();
    callback mode-changed();

    height: problem == "" ? 28px : 48px;
    background: Palette.background;
    border-width: 1px;
    border-radius: 3px;
    border-color: Palette.accent-background;
    clip: true;

    VerticalLayout {
        HorizontalLayout {
            height: 26px;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 8px;
            input := TextInput {
                horizontal-stretch: 1;
                single-line: true;
                vertical-alignment: center;
                color: Palette.foreground;
                init => {
                    self.focus();
                    self.select-all();
                }
                accepted => {
                    root.submit(self.text);
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.escape();
                        return accept;
                    }
                    reject
                }
            }
            Rectangle {
                width: root.content ? 130px : 0px;
                clip: true;
                border-width: root.content ? 1px : 0px;
                border-radius: 3px;
                border-color: Palette.border;
                names-input := TextInput {
                    x: 4px;
                    width: parent.width - 8px;
                    single-line: true;
                    vertical-alignment: center;
                    color: Palette.foreground;
                    accepted => {
                        root.submit(input.text);
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.escape();
                            return accept;
                        }
                        reject
                    }
                }
                if names-input.text == "": Text {
                    x: 4px;
                    text: @tr("파일 이름 조건 (예: *.txt)");
                    overflow: elide;
                    width: parent.width - 8px;
                    vertical-alignment: center;
                    color: Palette.foreground.transparentize(60%);
                }
            }
            Rectangle {
                width: root.content ? 64px : 0px;
                clip: true;
                Text {
                    text: root.regex ? @tr("☑ 정규식") : @tr("☐ 정규식");
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                TouchArea {
                    enabled: root.content;
                    clicked => {
                        root.regex = !root.regex;
                        root.mode-changed();
                        input.focus();
                    }
                }
            }
            Rectangle {
                width: 28px;
                Text {
                    text: @tr("이름");
                    vertical-alignment: center;
                    font-weight: root.content ? 400 : 700;
                    color: root.content ? Palette.foreground.transparentize(60%) : Palette.accent-background;
                }
                TouchArea {
                    clicked => {
                        root.content = false;
                        root.mode-changed();
                        input.focus();
                    }
                }
            }
            Rectangle {
                width: 28px;
                Text {
                    text: @tr("내용");
                    vertical-alignment: center;
                    font-weight: root.content ? 700 : 400;
                    color: root.content ? Palette.accent-background : Palette.foreground.transparentize(60%);
                }
                TouchArea {
                    clicked => {
                        root.content = true;
                        root.mode-changed();
                        input.focus();
                    }
                }
            }
        }
        if root.problem != "": Text {
            height: 20px;
            text: root.problem;
            overflow: elide;
            vertical-alignment: center;
            color: #b00020;
        }
    }

    changed focus-count => {
        input.focus();
        input.select-all();
    }
}

// 패널 하나: 탭 줄, 주소창, 알림, 자세히 보기, 상태 표시줄. 창에 둘(좌우)까지 놓인다.
// 패널을 누르면(어느 곳이든) `activate`가 먼저 불려 활성 패널이 되고, 그 뒤 동작은 활성 패널에 듣는다.
// 이름 입력란과 주소창 고쳐 쓰기는 활성 패널에서만 열린다(창이 `editing`·`address-editing`을 활성 패널에만 준다).
component PanelView inherits Rectangle {
    // 그릴 값: 수치·알림(`data`), 탭 줄, 경로 조각, 행.
    in property <PanelData> data;
    in property <[TabItem]> tabs;
    in property <[string]> segments;
    // 끌어 온 항목이 놓일 탭·경로 조각(없으면 -1).
    in property <int> drop-tab: -1;
    in property <int> drop-segment: -1;
    callback segment-geometry(int, length, length);
    in property <[Row]> rows;
    // 활성 패널인가. 패널이 둘일 때(`split`)만 테두리와 주소창 색으로 드러낸다.
    in property <bool> active;
    in property <bool> split;
    in property <bool> address-editing;
    in-out property <string> address-text;
    // 필터 입력란(활성 패널에만 열린다): 열렸는가, 글자, 포커스를 다시 달라는 신호(명령을 또 눌렀다).
    in property <bool> filter-open;
    in-out property <string> filter-text;
    in property <int> filter-focus;
    // 검색창(활성 패널에만 열린다): 열렸는가, 글자, 포커스를 다시 달라는 신호.
    in property <bool> search-open;
    in-out property <string> search-text;
    in property <int> search-focus;
    in-out property <bool> search-content;
    in-out property <bool> search-regex;
    in-out property <string> search-names;
    in property <string> search-problem;
    callback search-mode-changed();
    in property <int> editing: -1;
    in-out property <string> edit-text;
    // 이름 입력란을 열 때 고를 범위(UTF-8 바이트), 곁에 보일 까닭(Rust의 문장 모듈이 만든다), 확장자 바꿈을 묻는 중인가.
    in property <int> edit-selection-start;
    in property <int> edit-selection-end;
    in property <string> edit-problem;
    in property <bool> edit-asking-extension;
    // 상태 줄 알림(Rust의 문장 모듈이 만든다).
    in property <string> notice;
    in property <length> row-height;
    in-out property <length> name-width;
    in-out property <length> modified-width;
    in-out property <length> type-width;
    in-out property <length> size-width;
    in-out property <length> location-width;
    in-out property <length> matches-width;
    in-out property <length> content-y <=> list.content-y;
    out property <length> view-height: list.visible-height;
    out property <length> tab-width: clamp(tab-strip.width / max(1, root.tabs.length), 90px, 200px);
    in-out property <length> tab-strip-x <=> tab-flick.content-x;
    out property <length> tab-strip-width: tab-strip.width;
    // 탭 줄의 자리(창 기준)와 높이. 탭을 끌 때 Rust가 끄는 점이 어느 패널 탭 줄 위인지 본다.
    out property <length> tab-strip-left: tab-strip.absolute-position.x;
    out property <length> tab-strip-top: tab-strip.absolute-position.y;
    out property <length> tab-strip-height: tab-strip.height;
    // 탭 끌기: 끄는 탭(이 패널의 것이면 그 번호, 아니면 -1)과 놓일 자리(이 패널 탭 줄 위면 탭 사이 틈 번호, 아니면 -1).
    in property <int> dragged-tab: -1;
    in property <int> drop-slot: -1;
    // 다른 앱에서 파일을 끄는 동안 놓일 폴더 행(Rust가 정한다). 없으면 -1.
    in property <int> drop-row: -1;
    // 목록의 보이는 영역 자리(창 기준)와 너비(스크롤 막대 제외). 사각형 선택에서 Rust가 끄는 점을 행으로 바꾼다.
    out property <length> list-left: list.absolute-position.x;
    out property <length> list-top: list.absolute-position.y;
    out property <length> list-width: list.visible-width;
    // 사각형 선택 중 그릴 사각형(목록 내용 기준, Rust가 넣는다).
    in property <MarqueeBox> marquee;
    // 주소창의 자리(창 기준). 창이 자동 완성 후보를 그 아래에 놓는다.
    out property <length> address-x: address-bar.absolute-position.x;
    out property <length> address-y: address-bar.absolute-position.y + address-bar.height;
    out property <length> address-top: address-bar.absolute-position.y;
    out property <length> address-height: address-bar.height;
    out property <length> address-width: address-bar.width;
    // 툴팁을 보일 탭(마우스가 올라간 탭, 없으면 -1)과 그 탭의 왼쪽 끝, 툴팁을 보이는가.
    property <int> tip-tab: -1;
    property <length> tip-x;
    property <bool> tip-shown;

    // 이 패널을 눌렀다: 활성 패널로 한다. 다른 콜백보다 먼저 불린다.
    callback activate();
    // 마우스 버튼(뒤로·앞으로 버튼을 명령으로).
    callback pointer(PointerEvent);
    // 목록으로 키보드를 돌린다(주소창을 고쳐 쓰던 중이면 그만둔다). `focus-keys`는 그만두지 않고 돌리기만 한다.
    callback focus-list();
    callback focus-keys();
    callback row-pressed(int, bool, bool);
    callback row-opened(int);
    callback row-middle-pressed(int);
    // 오른쪽 버튼을 눌렀다: 행(목록 아래 빈 곳이면 -1), 창 기준 점. 오른쪽 메뉴를 연다.
    callback context-menu(int, length, length);
    callback tab-pressed(int);
    // 탭 끌기: 탭을 눌렀다(탭 번호, 창 기준 점), 누른 채 움직였다, 놓았다(누르기였으면 참: 그 탭으로 간다), 끌기가
    // 끊겼다.
    callback tab-drag-start(int, length, length);
    callback tab-drag-move(length, length);
    callback tab-drag-end(length, length) -> bool;
    callback tab-drag-cancel();
    // 빈 곳(목록 아래 -1, 행의 이름 글자 오른쪽 여백이면 그 행)을 왼쪽 버튼으로 눌렀다: 행, Ctrl, Shift, 창 기준 점.
    // 끌기 시작 문턱을 넘으면 사각형 선택, 아니면 누르기다(Rust가 정한다).
    callback marquee-press(int, bool, bool, length, length);
    // 항목 위(아이콘·이름 글자)를 눌렀다: 행, 오른쪽 버튼인가, Ctrl, Shift, 창 기준 점. 끌기 시작 문턱을 넘으면 항목
    // 끌기(OLE), 아니면 누르기(오른쪽이면 놓을 때 오른쪽 메뉴)다. 끄는 동안과 놓을 때는 Rust가 창의 마우스 이벤트로
    // 따라간다.
    callback item-press(int, bool, bool, bool, length, length);
    callback sort-by(int);
    // 이름 입력란: 확정(참이면 입력란을 닫았다), Esc(참이면 닫았다), 글자가 바뀜, 확장자 바꿈 확인의 답(참이면 닫았다).
    callback confirm-rename(string) -> bool;
    callback cancel-rename() -> bool;
    callback rename-edited(string);
    callback answer-extension(bool) -> bool;
    pure callback remove-selection(string, int, int) -> string;
    callback segment-pressed(int);
    callback begin-address-edit();
    callback address-edited(string);
    callback address-step(int) -> int;
    callback address-go(string) -> bool;
    callback cancel-address-edit();
    // 필터: 글자가 바뀌었다(곧바로 목록을 좁힌다), Esc(필터를 지우고 닫는다).
    callback filter-edited(string);
    callback cancel-filter();
    // 검색창: Enter(탐색 시작), Esc(닫기), 탐색 중지 단추.
    callback search-submit(string);
    callback cancel-search();
    callback stop-search();

    // 활성 패널의 테두리. 패널이 하나면 그리지 않는다.
    border-width: root.split ? 2px : 0px;
    border-color: root.active ? Palette.accent-background : Palette.border;

    // 빈 곳을 눌러도 활성 패널이 된다. 이름 입력란이 열려 있으면 입력란 밖을 누른 것이라 확정한다.
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (root.editing >= 0 && event.button == PointerEventButton.left) {
                    root.confirm-rename(root.edit-text);
                }
                root.activate();
            }
            root.pointer(event);
        }
    }

    VerticalLayout {
        padding: root.split ? 4px : 0px;
        spacing: 4px;

        // 탭 줄: 패널의 탭들. 활성 탭은 배경과 아래 선으로 보인다. 누르면 그 탭으로 간다. 끌면(끌기 시작 문턱을 넘으면)
        // 순서를 바꾸거나 반대편 패널·다른 창으로 옮기고(창 밖이면 새 창, Rust가 정한다), 끄는 동안 놓일 자리를 세로 선으로 보인다. 마우스로 끌어 줄을 넘기지
        // 않고(탭 끌기가 쓴다) 휠로 넘긴다.
        tab-strip := Rectangle {
            height: 30px;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;
            tab-flick := Flickable {
                content-width: max(self.width, root.tabs.length * root.tab-width);
                content-height: self.height;
                mouse-drag-pan-enabled: false;
                for tab[i] in root.tabs: Rectangle {
                    x: i * root.tab-width;
                    width: root.tab-width;
                    height: tab-strip.height;
                    opacity: i == root.dragged-tab ? 0.5 : 1;
                    background: tab.active ? Palette.background
                        : tab-touch.has-hover ? Palette.alternate-background : Palette.control-background;
                    tab-touch := TouchArea {
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.cancel) {
                                root.tab-drag-cancel();
                            } else if (event.button == PointerEventButton.left) {
                                if (event.kind == PointerEventKind.down) {
                                    root.tab-drag-start(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                } else if (event.kind == PointerEventKind.up) {
                                    if (root.tab-drag-end(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y)) {
                                        root.activate();
                                        root.tab-pressed(i);
                                    }
                                    root.focus-list();
                                }
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.tab-drag-move(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                        // 세로 휠로 탭 줄을 가로로 넘긴다(넘칠 때만).
                        scroll-event(event) => {
                            if (event.delta-y != 0 && tab-flick.content-width > tab-flick.width) {
                                root.tab-strip-x = clamp(root.tab-strip-x + event.delta-y, tab-flick.width - tab-flick.content-width, 0px);
                                return accept;
                            }
                            reject
                        }
                        changed has-hover => {
                            if (self.has-hover) {
                                root.tip-tab = i;
                                root.tip-x = self.absolute-position.x;
                            } else if (root.tip-tab == i) {
                                root.tip-tab = -1;
                                root.tip-shown = false;
                            }
                        }
                    }
                    if i == root.drop-tab: Rectangle {
                        background: Palette.accent-background.transparentize(65%);
                    }
                    // 탭 사이 경계.
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Palette.border;
                    }
                    if tab.active: Rectangle {
                        y: parent.height - 2px;
                        height: 2px;
                        background: Palette.accent-background;
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            ItemIcon {
                                folder: true;
                            }
                        }
                        Text {
                            text: tab.title;
                            overflow: elide;
                            vertical-alignment: center;
                            font-weight: tab.active ? 700 : 400;
                            color: Palette.foreground.transparentize(tab.active ? 0% : 25%);
                        }
                    }
                }
                // 끄는 탭이 놓일 자리: 탭 사이 틈의 세로 선.
                if root.drop-slot >= 0: Rectangle {
                    x: clamp(root.drop-slot * root.tab-width - 2px, 0px, max(0px, tab-flick.content-width - 4px));
                    width: 4px;
                    height: tab-strip.height;
                    background: Palette.accent-background;
                }
            }
        }

        // 주소창. 평소에는 경로 조각을 누르는 모드이고, 빈 곳을 누르거나 주소창 고쳐 쓰기 명령(Alt+D·Ctrl+L·F4)이면
        // 글자로 고쳐 쓰는 모드가 된다.
        address-bar := Rectangle {
            height: 28px;
            // 패널이 둘이면 활성 패널의 주소창을 강조색으로 칠한다.
            background: root.split && root.active ? Palette.accent-background.transparentize(82%) : Palette.background;
            border-width: 1px;
            border-radius: 3px;
            border-color: root.address-editing || (root.split && root.active) ? Palette.accent-background : Palette.border;
            clip: true;

            if !root.address-editing: Rectangle {
                // 조각 사이나 조각 뒤의 빈 곳을 누르면 고쳐 쓴다.
                TouchArea {
                    mouse-cursor: text;
                    clicked => {
                        root.activate();
                        root.begin-address-edit();
                    }
                }
                HorizontalLayout {
                    padding: 2px;
                    alignment: start;
                    for segment[i] in root.segments: HorizontalLayout {
                        Segment {
                            // 현재 폴더(마지막 조각)는 온전히 보인다. 자리가 모자라면 앞쪽(상위) 조각이 줄어든다.
                            min-width: i == root.segments.length - 1 ? min(self.preferred-width, address-bar.width - 8px) : 0px;
                            horizontal-stretch: i == root.segments.length - 1 ? 1 : 0;
                            text: segment;
                            drop-target: i == root.drop-segment;
                            geometry(x, w) => {
                                root.segment-geometry(i, x, w);
                            }
                            pressed => {
                                root.activate();
                                root.segment-pressed(i);
                                root.focus-list();
                            }
                        }
                        if i < root.segments.length - 1: Text {
                            text: "›";
                            vertical-alignment: center;
                            color: Palette.foreground.transparentize(40%);
                        }
                    }
                }
            }

            // 고쳐 쓰는 입력란. 한글 IME의 조합 글자와 후보 창은 TextInput이 처리한다.
            if root.address-editing: TextInput {
                x: 6px;
                width: parent.width - 12px;
                single-line: true;
                vertical-alignment: center;
                color: Palette.foreground;
                text <=> root.address-text;
                init => {
                    self.focus();
                    self.select-all();
                }
                edited => {
                    root.address-edited(self.text);
                }
                accepted => {
                    if (root.address-go(self.text)) {
                        root.focus-keys();
                    }
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.cancel-address-edit();
                        root.focus-keys();
                        return accept;
                    }
                    if (event.text == Key.Tab || event.text == Key.Backtab || event.text == Key.DownArrow
                        || event.text == Key.UpArrow) {
                        let backward = event.text == Key.Backtab || event.text == Key.UpArrow
                            || (event.text == Key.Tab && event.modifiers.shift);
                        let end = root.address-step(backward ? -1 : 1);
                        if (end >= 0) {
                            self.set-selection-offsets(end, end);
                        }
                        return accept;
                    }
                    reject
                }
            }
        }

        // 필터 입력란: 현재 폴더 목록을 이름으로 좁힌다. Esc는 필터를 지우고 목록으로 키보드를 돌린다.
        if root.filter-open: FilterBar {
            text <=> root.filter-text;
            focus-count: root.filter-focus;
            edited(text) => {
                root.filter-edited(text);
            }
            escape => {
                root.cancel-filter();
                root.focus-keys();
            }
        }

        // 검색창: 현재 폴더 아래 이름을 실시간으로 찾는다.
        if root.search-open: SearchBar {
            text <=> root.search-text;
            focus-count: root.search-focus;
            content <=> root.search-content;
            regex <=> root.search-regex;
            names <=> root.search-names;
            problem: root.search-problem;
            mode-changed => {
                root.search-mode-changed();
            }
            submit(text) => {
                root.search-submit(text);
                root.focus-keys();
            }
            escape => {
                root.cancel-search();
                root.focus-keys();
            }
        }

        if root.data.address-problem != Problem.none: Text {
            text: root.data.address-problem == Problem.address-empty ? @tr("주소를 입력하세요")
                : root.data.address-problem == Problem.address-invalid-character ? @tr("주소에 쓸 수 없는 글자가 있습니다: {}", root.data.address-problem-value)
                : root.data.address-problem == Problem.address-undefined-variable ? @tr("환경 변수가 없습니다: {}", root.data.address-problem-value)
                : root.data.address-problem == Problem.address-not-absolute ? @tr("전체 경로가 아닙니다: {}", root.data.address-problem-value)
                : root.data.address-problem == Problem.address-not-found ? @tr("위치가 없습니다: {}", root.data.address-problem-value)
                : root.data.address-problem == Problem.address-permission-denied ? @tr("위치를 확인할 권한이 없습니다: {}", root.data.address-problem-value)
                : @tr("위치를 확인하지 못했습니다: {}: {}", root.data.address-problem-value, root.data.address-problem-detail);
            wrap: word-wrap;
            color: #c42b1c;
        }

        if root.data.list-problem != Problem.none: Text {
            text: root.data.list-problem == Problem.not-found ? @tr("위치가 없습니다: {}", root.data.list-problem-location)
                : root.data.list-problem == Problem.permission-denied ? @tr("위치를 읽을 권한이 없습니다: {}", root.data.list-problem-location)
                : root.data.list-problem == Problem.not-a-folder ? @tr("폴더가 아닙니다: {}", root.data.list-problem-location)
                : @tr("위치를 읽지 못했습니다: {}: {}", root.data.list-problem-location, root.data.list-problem-detail);
            wrap: word-wrap;
            color: #c42b1c;
        }

        if root.data.open-problem != Problem.none: Text {
            text: root.data.open-problem == Problem.no-association ? @tr("이 형식의 파일에 연결된 프로그램이 없습니다")
                : root.data.open-problem == Problem.path-too-long ? @tr("경로가 너무 길어 셸이 열 수 없습니다")
                : root.data.open-problem == Problem.open-unsupported ? @tr("이 환경에서는 기본 프로그램으로 열 수 없습니다")
                : @tr("파일을 열지 못했습니다: {}", root.data.open-problem-detail);
            wrap: word-wrap;
            color: #c42b1c;
        }

        if root.data.relocation != 0: Text {
            text: root.data.relocation == 1 ? @tr("보던 위치가 사라져 상위 폴더로 옮겼습니다: {}", root.data.relocation-vanished)
                : @tr("보던 위치가 사라져 홈 폴더로 옮겼습니다: {}", root.data.relocation-vanished);
            wrap: word-wrap;
            color: #c42b1c;
        }

        if root.data.auto-refresh-off: Text {
            text: @tr("자동 새로 고침 안 됨 (F5로 새로 고침)");
            wrap: word-wrap;
            color: #8a6d00;
        }

        // 탐색 상태 띠: 탐색 중이면 찾은 수·훑은 폴더 수와 중지 단추, 끝나면 요약.
        if root.data.search-status != "": Rectangle {
            height: 24px;
            background: Palette.accent-background.transparentize(85%);
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.data.search-status;
                    overflow: elide;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                if root.data.search-running: Rectangle {
                    width: 52px;
                    border-width: 1px;
                    border-radius: 3px;
                    border-color: Palette.border;
                    Text {
                        text: @tr("중지");
                        color: Palette.foreground;
                    }
                    TouchArea {
                        clicked => {
                            root.activate();
                            root.stop-search();
                        }
                    }
                }
            }
        }

        // 열 머리글
        HorizontalLayout {
            height: root.row-height;
            Header {
                text: @tr("이름");
                column-width <=> root.name-width;
                sorted: root.data.sort-column == 0;
                descending: root.data.sort-descending;
                sort => {
                    root.activate();
                    root.sort-by(0);
                    root.focus-list();
                }
            }
            Header {
                text: @tr("수정한 날짜");
                column-width <=> root.modified-width;
                sorted: root.data.sort-column == 1;
                descending: root.data.sort-descending;
                sort => {
                    root.activate();
                    root.sort-by(1);
                    root.focus-list();
                }
            }
            Header {
                text: @tr("유형");
                column-width <=> root.type-width;
                sorted: root.data.sort-column == 2;
                descending: root.data.sort-descending;
                sort => {
                    root.activate();
                    root.sort-by(2);
                    root.focus-list();
                }
            }
            Header {
                text: @tr("크기");
                right-aligned: true;
                column-width <=> root.size-width;
                sorted: root.data.sort-column == 3;
                descending: root.data.sort-descending;
                sort => {
                    root.activate();
                    root.sort-by(3);
                    root.focus-list();
                }
            }
            if root.data.results: Header {
                text: @tr("위치");
                column-width <=> root.location-width;
                sorted: root.data.sort-column == 4;
                descending: root.data.sort-descending;
                sort => {
                    root.activate();
                    root.sort-by(4);
                    root.focus-list();
                }
            }
            if root.data.content-results: Header {
                text: @tr("일치");
                column-width <=> root.matches-width;
                sorted: root.data.sort-column == 5;
                descending: root.data.sort-descending;
                sort => {
                    root.activate();
                    root.sort-by(5);
                    root.focus-list();
                }
            }
            Rectangle { }
        }

        Rectangle {
            vertical-stretch: 1;

            // ListView는 보이는 행만 화면 요소로 만든다.
            // 높이를 행 높이의 정수배로 맞춘다. ListView는 먼 곳으로 뛸 때 스크롤 위치를 행 경계로
            // 내림하므로, 그렇지 않으면 End 뒤 마지막 행이 조금 가려진다.
            list := ListView {
                y: 0;
                height: floor(parent.height / root.row-height) * root.row-height;
                // 내용 높이에 빈 곳 한 행 높이를 더한다: 꽉 찬 목록도 끝까지 넘기면 아래 빈 곳 TouchArea가 닿는다.
                content-height: root.rows.length * root.row-height + root.row-height;
                for row[i] in root.rows: Rectangle {
                    height: root.row-height;
                    background: row.selected ? Palette.selection-background : transparent;
                    // 커서: 선택과 구분되게 테두리로 보인다.
                    Rectangle {
                        border-width: row.cursor ? 1px : 0px;
                        border-color: Palette.accent-background;
                    }
                    // 끌어 온 파일이 놓일 폴더 행: 강조색 바탕과 두꺼운 테두리.
                    if i == root.drop-row: Rectangle {
                        background: Palette.accent-background.transparentize(0.75);
                        border-width: 2px;
                        border-color: Palette.accent-background;
                    }
                    // 이름 글자의 너비를 재는 보이지 않는 글자: 이름 글자 오른쪽 여백(빈 곳)이 어디부터인지 정한다.
                    name-measure := Text {
                        text: row.name;
                        visible: false;
                    }
                    // 입력란보다 아래에 둔다. 그래야 입력란 안을 누르면 입력란이 받는다.
                    TouchArea {
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                root.activate();
                            }
                            root.pointer(event);
                            // 오른쪽 클릭: 오른쪽 메뉴. 선택에 없는 항목이면 Rust가 그 항목 하나로 고른다. 아이콘·이름 글자
                            // 위면 끌면 오른쪽 끌기라 메뉴는 끌지 않고 놓을 때 연다.
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right && i != root.editing) {
                                if (self.mouse-x > min(28px + name-measure.preferred-width, root.name-width - 8px)) {
                                    root.context-menu(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                } else {
                                    root.item-press(i, true, event.modifiers.control, event.modifiers.shift,
                                        self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                                root.focus-list();
                                return;
                            }
                            // 휠 클릭: 폴더를 새 탭에서 연다. 선택과 커서는 그대로다.
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.middle) {
                                root.row-middle-pressed(i);
                                return;
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                if (i == root.editing) {
                                    return;
                                }
                                // 다른 행을 누르면 탐색기처럼 입력을 확정하고 그 행을 고른다. 막혀 입력란이 남으면 고르지
                                // 않는다.
                                if (root.editing >= 0 && !root.confirm-rename(root.edit-text)) {
                                    return;
                                }
                                // 아이콘과 이름 글자 위는 항목 위, 그 오른쪽(이름 칸 여백과 다른 칸)은 빈 곳이다. 빈 곳은
                                // 끌면 사각형 선택이고 끌지 않고 놓으면 이 행을 누른 것이다(Rust가 놓을 때 고른다).
                                if (self.mouse-x > min(28px + name-measure.preferred-width, root.name-width - 8px)) {
                                    root.marquee-press(i, event.modifiers.control, event.modifiers.shift,
                                        self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                } else {
                                    root.item-press(i, false, event.modifiers.control, event.modifiers.shift,
                                        self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                                root.focus-list();
                            }
                        }
                        double-clicked => {
                            if (i != root.editing) {
                                root.row-opened(i);
                                root.focus-list();
                            }
                        }
                    }
                    HorizontalLayout {
                        HorizontalLayout {
                            width: root.name-width;
                            padding-left: 6px;
                            padding-right: 8px;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                ItemIcon {
                                    folder: row.folder;
                                    opacity: row.cut ? 0.45 : 1.0;
                                }
                            }
                            if i != root.editing: Text {
                                opacity: row.cut ? 0.45 : 1.0;
                                text: row.name;
                                overflow: elide;
                                vertical-alignment: center;
                                color: row.selected ? Palette.selection-foreground : Palette.foreground;
                            }
                            // 이름 입력란. 한글 IME의 조합 글자와 후보 창은 TextInput이 처리한다.
                            if i == root.editing: Rectangle {
                                horizontal-stretch: 1;
                                background: Palette.background;
                                border-width: 1px;
                                border-color: Palette.accent-background;
                                clip: true;
                                name-input := TextInput {
                                    x: 3px;
                                    width: parent.width - 6px;
                                    single-line: true;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                    text <=> root.edit-text;
                                    // 파일은 확장자 앞까지, 폴더와 확장자 없는 파일은 전체를 고른 채 연다(코어의 처음 선택 범위).
                                    init => {
                                        self.focus();
                                        self.set-selection-offsets(root.edit-selection-start, root.edit-selection-end);
                                    }
                                    edited => {
                                        root.rename-edited(self.text);
                                    }
                                    // Slint는 선택이 있어도 조합 글자를 커서 자리에 끼워 넣기만 한다.
                                    // 조합이 시작될 때 선택을 먼저 지워 첫 글자에서 바뀌게 한다.
                                    changed preedit-text => {
                                        if (self.preedit-text != ""
                                            && self.anchor-position-byte-offset != self.cursor-position-byte-offset) {
                                            let start = min(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                                            root.edit-text = root.remove-selection(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                                            self.set-selection-offsets(start, start);
                                        }
                                    }
                                    accepted => {
                                        if (root.confirm-rename(self.text)) {
                                            root.focus-keys();
                                        }
                                    }
                                    // Ctrl+Z·Ctrl+Y 등은 거절해 입력란이 글자 편집으로 쓴다(단축키로 넘기지 않는다: 이
                                    // 입력란은 키 입력란 `keys` 밖에 있다).
                                    key-pressed(event) => {
                                        if (event.text == Key.Escape) {
                                            if (root.cancel-rename()) {
                                                root.focus-keys();
                                            }
                                            return accept;
                                        }
                                        // 입력란이 열린 동안에는 목록을 움직이지 않는다.
                                        if (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.PageUp
                                            || event.text == Key.PageDown || event.text == Key.F2) {
                                            return accept;
                                        }
                                        reject
                                    }
                                }
                            }
                        }
                        Text {
                            width: root.modified-width;
                            text: row.modified;
                            overflow: elide;
                            vertical-alignment: center;
                            color: row.selected ? Palette.selection-foreground : Palette.foreground;
                        }
                        Text {
                            width: root.type-width;
                            text: row.kind;
                            overflow: elide;
                            vertical-alignment: center;
                            color: row.selected ? Palette.selection-foreground : Palette.foreground;
                        }
                        HorizontalLayout {
                            width: root.size-width;
                            padding-right: 8px;
                            Text {
                                text: row.size;
                                overflow: elide;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                color: row.selected ? Palette.selection-foreground : Palette.foreground;
                            }
                        }
                        if root.data.results: HorizontalLayout {
                            width: root.location-width;
                            padding-right: 8px;
                            Text {
                                text: row.location;
                                overflow: elide;
                                vertical-alignment: center;
                                color: row.selected ? Palette.selection-foreground : Palette.foreground;
                            }
                        }
                        if root.data.content-results: HorizontalLayout {
                            width: root.matches-width;
                            padding-right: 8px;
                            Text {
                                text: row.matches;
                                overflow: elide;
                                vertical-alignment: center;
                                color: row.selected ? Palette.selection-foreground : Palette.foreground;
                            }
                        }
                        Rectangle { }
                    }
                }
            }

            // 목록 아래 빈 곳: 눌러 끌면 사각형 선택이다. 누르기만 하면 전처럼 아무것도 고르지 않는다.
            TouchArea {
                y: clamp(root.rows.length * root.row-height + root.content-y, 0px, list.height);
                width: list.visible-width;
                height: list.height - self.y;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        if (root.editing >= 0 && event.button == PointerEventButton.left) {
                            root.confirm-rename(root.edit-text);
                        }
                        root.activate();
                    }
                    root.pointer(event);
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                        root.context-menu(-1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        root.focus-list();
                        return;
                    }
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.marquee-press(-1, event.modifiers.control, event.modifiers.shift,
                            self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }

            // 사각형 선택의 반투명 사각형. 목록과 함께 넘어가고 보이는 영역 밖은 자른다.
            Rectangle {
                width: list.visible-width;
                height: list.height;
                clip: true;
                if root.marquee.shown: Rectangle {
                    x: root.marquee.x;
                    y: root.marquee.y + root.content-y;
                    width: root.marquee.width;
                    height: root.marquee.height;
                    background: Palette.accent-background.transparentize(80%);
                    border-width: 1px;
                    border-color: Palette.accent-background;
                }
            }

            // 이름 입력란 곁의 풍선: 막힌 까닭과 확장자 바꿈 확인(예·아니오). 입력란 행 아래(자리가 없으면 위)에 뜬다.
            // 눌러도 키보드는 입력란에 남는다.
            if root.editing >= 0 && (root.edit-problem != "" || root.edit-asking-extension): Rectangle {
                property <length> row-top: root.editing * root.row-height + root.content-y;
                x: 28px;
                width: min(parent.width - 36px, 480px);
                height: balloon-layout.preferred-height;
                y: row-top + root.row-height + self.height <= parent.height ? row-top + root.row-height : max(0px, row-top - self.height);
                background: Palette.background;
                border-width: 1px;
                border-radius: 3px;
                border-color: root.edit-asking-extension ? Palette.accent-background : #c42b1c;
                drop-shadow-blur: 4px;
                drop-shadow-color: #00000040;
                TouchArea { }
                balloon-layout := VerticalLayout {
                    padding: 6px;
                    spacing: 4px;
                    if root.edit-problem != "": Text {
                        text: root.edit-problem;
                        wrap: word-wrap;
                        color: #c42b1c;
                    }
                    if root.edit-asking-extension: Text {
                        text: @tr("확장자를 바꾸면 파일을 쓸 수 없게 될 수도 있습니다. 바꾸시겠습니까? (Enter 예, Esc 아니오)");
                        wrap: word-wrap;
                        color: Palette.foreground;
                    }
                    if root.edit-asking-extension: HorizontalLayout {
                        alignment: end;
                        spacing: 6px;
                        SmallButton {
                            text: @tr("예");
                            clicked => {
                                if (root.answer-extension(true)) {
                                    root.focus-keys();
                                }
                            }
                        }
                        SmallButton {
                            text: @tr("아니오");
                            clicked => {
                                root.answer-extension(false);
                            }
                        }
                    }
                }
            }

            if root.data.reading: Rectangle {
                background: Palette.background.transparentize(30%);
                Text {
                    text: @tr("읽는 중…");
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            Text {
                text: root.data.total-count >= 0 ? @tr("{} / 전체 {} 항목", root.data.item-count, root.data.total-count) : @tr("{n}개 항목" | "{n}개 항목" % root.data.item-count);
                color: Palette.foreground.transparentize(40%);
            }
            if root.data.selected-count > 0: Text {
                text: @tr("{n}개 선택함" | "{n}개 선택함" % root.data.selected-count);
                color: Palette.foreground.transparentize(40%);
            }
            if root.data.selected-size != "": Text {
                text: root.data.selected-size;
                color: Palette.foreground.transparentize(40%);
            }
            Text {
                text: root.notice;
                horizontal-stretch: 1;
                overflow: elide;
                color: Palette.foreground.transparentize(40%);
            }
        }
    }

    // 탭 툴팁: 마우스를 탭에 잠시 올려 두면 탭 줄 아래에 그 탭의 전체 경로를 보인다.
    Timer {
        interval: 500ms;
        running: root.tip-tab >= 0 && !root.tip-shown;
        triggered => {
            root.tip-shown = true;
        }
    }
    Rectangle {
        if root.tip-shown && root.tip-tab >= 0 && root.tip-tab < root.tabs.length: Rectangle {
            x: max(0px, min(root.tip-x - parent.absolute-position.x, parent.width - self.width));
            y: tab-strip.absolute-position.y - parent.absolute-position.y + tab-strip.height + 2px;
            width: min(tip-text.preferred-width + 12px, parent.width);
            height: 22px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000040;
            tip-text := Text {
                x: 6px;
                width: parent.width - 12px;
                text: root.tabs[root.tip-tab].path;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }

}

// 오른쪽 메뉴 한 칸(메인이나 하위): 줄들을 위에서 아래로 그린다. 줄 높이는 Rust의 `context_menu::ROW_HEIGHT`·
// `SEPARATOR_HEIGHT`·`PADDING`과 같다. 꺼진 줄은 흐리게 보이고 고를 수 없다.
component ContextMenuView inherits Rectangle {
    in property <[MenuRow]> rows;
    in property <int> selected: -1;
    callback hover(int);
    callback activate(int);
    background: Palette.background;
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 6px;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000060;
    // 메뉴 안을 누르면 바깥 누르기로 닫히지 않게 받는다.
    TouchArea { }
    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        alignment: start;
        for row[i] in root.rows: Rectangle {
            height: row.separator ? 9px : 28px;
            if row.separator: Rectangle {
                y: 4px;
                height: 1px;
                background: Palette.border;
            }
            if !row.separator: Rectangle {
                x: 4px;
                width: parent.width - 8px;
                background: i == root.selected ? Palette.selection-background : transparent;
                border-radius: 4px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 8px;
                    spacing: 6px;
                    Text {
                        width: 16px;
                        text: row.mark;
                        vertical-alignment: center;
                        color: (i == root.selected ? Palette.selection-foreground : Palette.foreground)
                            .transparentize(row.enabled ? 0% : 60%);
                    }
                    Text {
                        text: row.name;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                        color: (i == root.selected ? Palette.selection-foreground : Palette.foreground)
                            .transparentize(row.enabled ? 0% : 60%);
                    }
                    Text {
                        text: row.submenu ? "▶" : row.shortcut;
                        vertical-alignment: center;
                        color: (i == root.selected ? Palette.selection-foreground : Palette.foreground)
                            .transparentize(row.enabled ? 40% : 70%);
                    }
                }
                row-touch := TouchArea {
                    changed has-hover => {
                        if (self.has-hover && row.enabled) {
                            root.hover(i);
                        }
                    }
                    clicked => {
                        if (row.enabled) {
                            root.activate(i);
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    // 활성 탭의 폴더 이름. 창 제목에 붙여 지금 어디에 있는지 보이게 한다.
    in property <string> folder-title;
    title: root.folder-title == "" ? "facet" : root.folder-title + " - facet";
    preferred-width: 900px;
    preferred-height: 600px;
    default-font-size: 13px;

    // 패널이 둘(좌우)인가, 활성 패널(0 왼쪽, 1 오른쪽), 분할 비율(왼쪽 패널의 몫, 코어가 한도 안으로 자른 값).
    in property <bool> split;
    in property <int> active-panel;
    in property <float> split-ratio: 0.5;
    // 패널마다 그릴 값. `left-*`는 왼쪽(하나뿐이면 그 패널), `right-*`는 오른쪽 패널이다.
    in property <PanelData> left-data;
    in property <[TabItem]> left-tabs;
    in property <[string]> left-segments;
    in property <[Row]> left-rows;
    in property <PanelData> right-data;
    in property <[TabItem]> right-tabs;
    in property <[string]> right-segments;
    in property <[Row]> right-rows;
    // 패널마다 목록의 스크롤 위치(0 이하, 목록 맨 위에서 화면 맨 위까지 내려간 거리의 음수)와 보이는 높이.
    in-out property <length> left-content-y <=> left.content-y;
    out property <length> left-view-height: left.view-height;
    in-out property <length> right-content-y <=> right.content-y;
    out property <length> right-view-height: right.view-height;
    // 패널마다 탭 줄: 탭 너비, 넘긴 자리(Rust가 활성 탭을 보이게 맞춘다), 줄 너비.
    out property <length> left-tab-width: left.tab-width;
    in-out property <length> left-tab-strip-x <=> left.tab-strip-x;
    out property <length> left-tab-strip-width: left.tab-strip-width;
    out property <length> right-tab-width: right.tab-width;
    in-out property <length> right-tab-strip-x <=> right.tab-strip-x;
    out property <length> right-tab-strip-width: right.tab-strip-width;
    // 패널마다 탭 줄의 자리(창 기준)와 높이: 탭을 끌 때 끄는 점이 어느 탭 줄 위인지 본다.
    out property <length> left-tab-strip-left: left.tab-strip-left;
    out property <length> left-tab-strip-top: left.tab-strip-top;
    out property <length> left-tab-strip-height: left.tab-strip-height;
    out property <length> right-tab-strip-left: right.tab-strip-left;
    out property <length> right-tab-strip-top: right.tab-strip-top;
    out property <length> right-tab-strip-height: right.tab-strip-height;
    // 탭 끌기(Rust가 정한다): 패널마다 끄는 탭과 놓일 자리. 없으면 -1.
    in property <int> left-dragged-tab: -1;
    in property <int> left-drop-slot: -1;
    in property <int> right-dragged-tab: -1;
    in property <int> right-drop-slot: -1;
    // 다른 앱에서 끌어 온 파일이 놓일 폴더 행(Rust가 정한다): 패널마다. 없으면 -1.
    in property <int> left-drop-row: -1;
    // 끌어 온 항목이 놓일 탭·경로 조각(패널마다, 없으면 -1)과 주소창의 세로 자리.
    in property <int> left-drop-tab: -1;
    in property <int> right-drop-tab: -1;
    in property <int> left-drop-segment: -1;
    in property <int> right-drop-segment: -1;
    out property <length> left-address-top: left.address-top;
    out property <length> left-address-height: left.address-height;
    out property <length> right-address-top: right.address-top;
    out property <length> right-address-height: right.address-height;
    callback segment-geometry(int, int, length, length);
    in property <int> right-drop-row: -1;
    // 사각형 선택: 패널마다 목록의 보이는 영역 자리(창 기준)와 너비, 그릴 사각형(Rust가 정한다).
    out property <length> left-list-left: left.list-left;
    out property <length> left-list-top: left.list-top;
    out property <length> left-list-width: left.list-width;
    out property <length> right-list-left: right.list-left;
    out property <length> right-list-top: right.list-top;
    out property <length> right-list-width: right.list-width;
    in property <MarqueeBox> left-marquee;
    in property <MarqueeBox> right-marquee;
    // 주소창(활성 패널): 글자로 고쳐 쓰는 모드인가. 아니면 경로 조각 모드다.
    in property <bool> address-editing;
    // 고쳐 쓰는 글자. 모드를 열 때 Rust가 지금 위치를 채운다.
    in-out property <string> address-text;
    // 필터 입력란(활성 패널): 열렸는가, 글자, 포커스를 다시 달라는 신호.
    in property <bool> filter-open;
    in-out property <string> filter-text;
    in property <int> filter-focus;
    // 검색창(활성 패널): 열렸는가, 글자, 포커스를 다시 달라는 신호.
    in property <bool> search-open;
    in-out property <string> search-text;
    in property <int> search-focus;
    in-out property <bool> search-content;
    in-out property <bool> search-regex;
    in-out property <string> search-names;
    in property <string> search-problem;
    callback search-mode-changed();
    // 자동 완성 후보(하위 폴더 이름)와 Tab·화살표로 고른 후보의 번호(없으면 -1).
    in property <[string]> candidates;
    in property <int> candidate-highlight: -1;
    out property <length> candidate-row-height: 22px;
    in-out property <length> candidate-content-y <=> candidate-list.content-y;
    out property <length> candidate-view-height: candidate-list.visible-height;
    in-out property <bool> show-about;
    // 세션 파일이 깨져 기본 창으로 시작했다(첫 창만). 「닫기」를 누르면 감춘다. `session-kept`는 원래 파일을 옆에 남긴
    // 자리이고, 남기지 못했으면 비어 있다.
    in-out property <bool> session-broken;
    in property <string> session-kept;
    // 명령 팔레트: 열려 있는가, 검색 결과 줄, 고른 줄(없으면 -1), 입력 글자.
    in property <bool> palette-open;
    in property <[PaletteRow]> palette-rows;
    in property <int> palette-highlight: -1;
    in-out property <string> palette-text;
    // 복사·이동 대상 선택 창: 열려 있는가, 이동인가, 원본 항목 수, 줄(반대편 패널 위치·최근 대상·자동 완성 후보), 고른
    // 줄(없으면 -1), 입력 글자, 해석하지 못한 까닭(주소창과 같은 글자 해석·폴더가 아님)과 시작 전에 막힌 까닭.
    in property <bool> target-open;
    in property <bool> target-moving;
    in property <int> target-items;
    in property <[TargetRow]> target-rows;
    in property <int> target-highlight: -1;
    in-out property <string> target-text;
    in property <Problem> target-problem: Problem.none;
    in property <string> target-problem-value;
    in property <string> target-problem-detail;
    in property <TransferProblem> target-transfer-problem: TransferProblem.none;
    in property <string> target-transfer-problem-path;
    property <bool> target-has-problem: root.target-problem != Problem.none || root.target-transfer-problem != TransferProblem.none;
    // 활성 패널에서 이름 입력란이 열린 행. 없으면 -1.
    in property <int> editing: -1;
    // 이름 입력란의 글자. 열 때 Rust가 현재 이름을 채운다.
    in-out property <string> edit-text;
    // 이름 입력란을 열 때 고를 범위(UTF-8 바이트, 코어의 처음 선택 범위), 곁에 보일 까닭, 확장자 바꿈을 묻는 중인가.
    in property <int> edit-selection-start;
    in property <int> edit-selection-end;
    in property <string> edit-problem;
    in property <bool> edit-asking-extension;
    // 활성 패널의 상태 줄에 보일 알림(이름바꾸기·새 폴더가 실패한 까닭 등). Rust의 문장 모듈이 만든다.
    in property <string> notice;
    out property <length> row-height: 24px;
    // 작업 영역: 작업 대기열의 작업들(모든 창에 같은 것). 작업이 없으면 자리를 차지하지 않는다.
    in property <[JobRow]> jobs;
    out property <length> job-height: 56px;
    // 질문 대화가 붙은 진행 표시가 더 차지하는 높이와, 질문을 기다리는 작업 수(Rust가 넣는다).
    out property <length> question-height: 120px;
    in property <int> job-questions;
    // 못 한 항목 줄이 붙은 진행 표시가 더 차지하는 높이와, 그런 작업 수(Rust가 넣는다).
    out property <length> report-height: 18px;
    in property <int> job-reports;
    // 작업 영역의 높이: 진행 표시 세 개(질문 대화는 두 개)까지 보이고 넘으면 넘겨 본다.
    property <length> work-height: root.jobs.length == 0 ? 0px
        : min(root.jobs.length * root.job-height + root.job-questions * root.question-height + root.job-reports * root.report-height,
            min(root.jobs.length, 3) * root.job-height + min(root.job-questions, 2) * root.question-height
                + min(root.job-reports, 3) * root.report-height) + 4px;
    // 작업 기록 보기: 열려 있는가, 줄(최근 것부터). 읽기 전용이고 Esc·바깥 누르기로 닫는다(`history-close`).
    in property <bool> history-open;
    in property <[HistoryRow]> history-rows;
    callback history-close();
    // 확인 줄: 열려 있는가, 이동인가, 대상 폴더, 항목 수, 시작 전에 막힌 까닭과 그 경로. 삭제 확인이면 그 까닭
    // (`confirm-delete`)과 항목이 하나일 때 그 이름(`confirm-name`, 여럿이면 비어 있고 항목 수를 보인다).
    in property <bool> confirm-open;
    in property <DeleteConfirm> confirm-delete;
    in property <string> confirm-name;
    in property <bool> confirm-moving;
    in property <string> confirm-target;
    in property <int> confirm-items;
    in property <TransferProblem> confirm-problem;
    in property <string> confirm-problem-path;
    property <length> confirm-height: root.confirm-open ? 38px : 0px;
    // 열 너비. 머리글 경계를 끌어 바꾼다. 두 패널이 함께 쓴다.
    in-out property <length> name-width: 320px;
    in-out property <length> modified-width: 140px;
    in-out property <length> type-width: 120px;
    in-out property <length> size-width: 90px;
    in-out property <length> location-width: 240px;
    in-out property <length> matches-width: 320px;

    // 키 입력 하나: 키의 글자와 수식 키. Rust가 명령이나 커서 이동으로 처리했으면 참을 돌려준다.
    // 거짓이면 글자 입력으로 보고 `typed`로 넘어온다(한글은 IME가 조합을 끝낸 뒤).
    callback key(string, bool, bool, bool) -> bool;
    // 글자로 이동: 조합이 끝난 글자.
    callback typed(string);
    // 패널을 눌렀다: 그 패널(0 왼쪽, 1 오른쪽)을 활성 패널로 한다. 아래 콜백들은 그 뒤에 불려 활성 패널에 듣는다.
    callback panel-pressed(int);
    // 패널 사이 경계를 끌었다: 바라는 분할 비율. Rust가 한도 안으로 잘라 `split-ratio`에 넣는다.
    callback split-dragged(float);
    // 패널 사이 경계를 두 번 눌렀다: 반반으로 맞춘다.
    callback split-reset();
    // 행을 눌렀다: 행 번호, Ctrl, Shift.
    callback row-pressed(int, bool, bool);
    // 행을 두 번 눌렀다: 열기.
    callback row-opened(int);
    // 행을 휠 클릭했다: 폴더면 새 탭에서 연다.
    // 오른쪽 버튼을 눌렀다: 패널, 행(빈 곳이면 -1), 창 기준 점. Rust가 선택을 고르고 메뉴를 연다.
    callback context-menu(int, int, length, length);
    // 오른쪽 메뉴: 열려 있는가, 자리와 크기(Rust가 창 안으로 맞춘다), 줄, 고른 줄, 하위 메뉴(열려 있는가·자리·크기·줄·고른 줄).
    // 줄 높이·너비는 Rust의 `context_menu` 모듈과 같아야 한다.
    in property <bool> menu-open;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <length> menu-width;
    in property <length> menu-height;
    in property <[MenuRow]> menu-rows;
    in property <int> menu-selected: -1;
    in property <bool> menu-sub-open;
    in property <length> menu-sub-x;
    in property <length> menu-sub-y;
    in property <length> menu-sub-width;
    in property <length> menu-sub-height;
    in property <[MenuRow]> menu-sub-rows;
    in property <int> menu-sub-selected: -1;
    callback menu-hover(bool, int);
    callback menu-activate(bool, int);
    callback menu-key(string);
    callback menu-close();
    callback row-middle-pressed(int);
    // 탭 줄의 탭을 눌렀다: 그 탭으로 간다.
    callback tab-pressed(int);
    // 탭 끌기: 패널(0 왼쪽, 1 오른쪽)의 탭을 눌렀다(탭 번호, 창 기준 점), 누른 채 움직였다, 놓았다(누르기였으면
    // 참), 끌기가 끊겼다. 끌기 시작 문턱과 놓일 자리는 Rust가 정한다.
    callback tab-drag-start(int, int, length, length);
    callback tab-drag-move(length, length);
    callback tab-drag-end(length, length) -> bool;
    callback tab-drag-cancel();
    // 빈 곳을 왼쪽 버튼으로 눌렀다: 패널(0 왼쪽, 1 오른쪽), 행(목록 아래면 -1), Ctrl, Shift, 창 기준 점. 끄는 동안과 놓을
    // 때는 Rust가 창의 마우스 이벤트로 따라간다.
    callback marquee-press(int, int, bool, bool, length, length);
    // 항목 위를 눌렀다: 패널, 행, 오른쪽 버튼인가, Ctrl, Shift, 창 기준 점(PanelView의 같은 콜백).
    callback item-press(int, int, bool, bool, bool, length, length);
    // 열 머리글을 눌렀다: 열 번호.
    callback sort-by(int);
    // 마우스 뒤로(거짓)·앞로(참) 버튼.
    callback mouse-history(bool);
    // F2: 커서 항목의 이름 입력란을 연다.
    callback begin-rename();
    // Enter·입력란 밖 클릭: 입력을 확정한다. 참이면 입력란을 닫았다(코어 이름바꾸기에 넘겼거나 바꿀 것이 없음), 거짓이면
    // 막혀 입력란이 남았다(까닭이나 확장자 확인이 보인다).
    callback confirm-rename(string) -> bool;
    // Esc: 입력을 취소한다. 확장자 바꿈을 묻는 중이면 입력란으로 돌아가고 거짓이다.
    callback cancel-rename() -> bool;
    // 이름 입력란의 글자가 바뀌었다: 이름 확인을 다시 한다.
    callback rename-edited(string);
    // 확장자 바꿈 확인의 답(예 참). 참이면 입력란을 닫았다.
    callback answer-extension(bool) -> bool;
    // 글자에서 선택(앵커·커서 바이트 위치)을 지운 글자. 한글 조합이 시작될 때 쓴다.
    pure callback remove-selection(string, int, int) -> string;
    // 경로 조각을 눌렀다: 조각 번호.
    callback segment-pressed(int);
    // 주소창의 빈 곳을 눌렀다: 고쳐 쓰는 모드로 바꾼다.
    callback begin-address-edit();
    // 고쳐 쓰는 글자가 바뀌었다: 자동 완성 후보를 새로 읽는다.
    callback address-edited(string);
    // Tab·↓(1)이나 Shift+Tab·↑(-1)로 후보를 골랐다. Rust가 `address-text`를 그 후보로 바꾸고, 입력 커서를 둘
    // 글자 끝의 바이트 위치를 돌려준다. 고를 후보가 없으면 -1이다.
    callback address-step(int) -> int;
    // Enter: 고쳐 쓴 글자로 간다. 해석해서 가기 시작했으면 참(고쳐 쓰는 모드를 닫았다), 해석하지 못했으면 거짓이다.
    callback address-go(string) -> bool;
    // 자동 완성 후보를 눌렀다: 그 폴더로 간다.
    callback candidate-pressed(int);
    // Esc 등: 고쳐 쓰는 모드를 닫고 경로 조각 모드로 돌아간다.
    callback cancel-address-edit();
    // 필터 입력란: 글자가 바뀌었다(곧바로 거른다), Esc(필터를 지우고 닫는다).
    callback filter-edited(string);
    callback cancel-filter();
    // 검색창: Enter(탐색 시작), Esc(닫기), 탐색 중지.
    callback search-submit(string);
    callback cancel-search();
    callback stop-search();

    // 명령 팔레트: 글자가 바뀌었다(검색), 화살표(1·-1)로 골랐다, 줄을 실행한다(참이면 실행했다. 꺼진 명령이면 거짓),
    // 닫는다.
    callback palette-edited(string);
    callback palette-step(int);
    callback palette-run(int) -> bool;
    callback palette-close();

    // 대상 선택 창: 글자가 바뀌었다(자동 완성), 줄을 골랐다(1·-1, 입력 커서를 둘 글자 끝의 바이트 위치를 돌려주고 고를 줄이
    // 없으면 -1), Enter로 확정한다(참이면 작업을 넣고 닫았다. 해석하지 못했으면 거짓이고 창은 그대로다), 줄을 눌렀다(참이면
    // 닫았다), 닫는다.
    callback target-edited(string);
    callback target-step(int) -> int;
    callback target-accept(string) -> bool;
    callback target-row-pressed(int) -> bool;
    callback target-cancel();

    // 확인 줄: Enter·「시작」(막힌 까닭이 보이면 닫기), Esc·「취소」.
    callback confirm-accept();
    callback confirm-cancel();
    // 진행 표시의 단추: 작업 번호.
    callback job-pause(int);
    callback job-resume(int);
    callback job-cancel(int);
    callback job-start-now(int);
    callback job-dismiss(int);
    // 질문 대화의 답: 작업 번호와 답(이름 충돌은 「나머지에도 적용」도). 어느 창에서 답해도 한 번만 적용된다.
    callback job-answer-conflict(int, ConflictChoice, bool);
    callback job-answer-error(int, ErrorChoice);
    callback job-answer-not-recyclable(int, NotRecyclableChoice);

    forward-focus: keys;

    // 목록으로 키보드를 돌린다. 주소창을 고쳐 쓰던 중이면 그만둔다.
    function focus-list() {
        if (root.address-editing) {
            root.cancel-address-edit();
        }
        keys.focus();
    }

    // 마우스 뒤로·앞으로 버튼은 어디를 눌러도 명령을 부른다.
    function history-button(event: PointerEvent) {
        if (event.kind == PointerEventKind.down) {
            if (event.button == PointerEventButton.back) {
                root.mouse-history(false);
            } else if (event.button == PointerEventButton.forward) {
                root.mouse-history(true);
            }
        }
    }

    MenuBar {
        Menu {
            title: @tr("도움말");
            MenuItem {
                title: @tr("facet 정보");
                activated => {
                    root.show-about = true;
                }
            }
        }
    }

    TouchArea {
        pointer-event(event) => {
            root.history-button(event);
        }
    }

    // 키 입력을 받는 곳. 보이지 않는 입력란이다: 한글 IME가 조합을 끝낸 글자를 받으려면 입력란이어야 한다.
    // 명령·커서 키는 `key`가 먼저 가져가고, 나머지 글자만 입력란에 들어갔다가 곧바로 `typed`로 넘어간다.
    keys := TextInput {
        x: 0px;
        y: 0px;
        width: 1px;
        height: 1px;
        single-line: true;
        color: transparent;
        selection-background-color: transparent;
        key-pressed(event) => {
            // 오른쪽 메뉴가 열려 있으면 ↑↓→←·Enter·Esc가 메뉴를 고른다.
            if (root.menu-open) {
                root.menu-key(event.text);
                return accept;
            }
            if (root.palette-open || root.target-open) {
                return accept;
            }
            // 확인 줄이 열려 있으면 Enter로 시작, Esc로 취소하고 다른 키는 받지 않는다.
            if (root.confirm-open) {
                if (event.text == Key.Return) {
                    root.confirm-accept();
                } else if (event.text == Key.Escape) {
                    root.confirm-cancel();
                }
                return accept;
            }
            if (root.show-about) {
                if (event.text == Key.Escape) {
                    root.show-about = false;
                }
                return accept;
            }
            if (root.history-open) {
                if (event.text == Key.Escape) {
                    root.history-close();
                }
                return accept;
            }
            if (event.text == Key.F2) {
                root.begin-rename();
                return accept;
            }
            if (root.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift)) {
                return accept;
            }
            // Ctrl·Alt 조합(붙여넣기 등)은 글자 입력이 아니다.
            if (event.modifiers.control || event.modifiers.alt) {
                return accept;
            }
            reject
        }
        edited => {
            if (self.text != "") {
                root.typed(self.text);
                self.text = "";
            }
        }
    }

    // 패널들: 왼쪽 패널과, 나뉘었으면 경계와 오른쪽 패널. 오른쪽 패널은 늘 만들어 두고 나뉘지 않았으면 너비 0으로 숨긴다
    // (자동 완성 후보가 활성 패널의 주소창 자리를 읽고, 스크롤 위치를 Rust와 잇기 위해서다).
    // 세션 파일이 깨졌음을 알리는 띠. 보이면 패널들이 그만큼 아래로 내려간다.
    property <length> banner-height: root.session-broken ? 34px : 0px;
    if root.session-broken: Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: 28px;
        background: #fff4ce;
        border-radius: 4px;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 12px;
            Text {
                text: root.session-kept != ""
                    ? @tr("세션 파일이 깨져 기본 창으로 시작했습니다. 원래 파일은 {}에 남겼습니다", root.session-kept)
                    : @tr("세션 파일이 깨져 기본 창으로 시작했습니다. 원래 파일을 옆에 남기지 못했습니다");
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
                color: #6b5200;
            }
            Rectangle {
                width: banner-close.preferred-width;
                banner-close := Text {
                    text: @tr("닫기");
                    vertical-alignment: center;
                    color: #6b5200;
                }
                TouchArea {
                    clicked => {
                        root.session-broken = false;
                    }
                }
            }
        }
    }

    panels := Rectangle {
        x: 8px;
        y: 8px + root.banner-height;
        width: parent.width - 16px;
        height: parent.height - 16px - root.banner-height - root.confirm-height - root.work-height;
        property <length> gap: root.split ? 6px : 0px;
        property <length> left-width: root.split ? round((self.width - self.gap) * root.split-ratio / 1px) * 1px : self.width;

        left := PanelView {
            x: 0px;
            width: panels.left-width;
            height: parent.height;
            data: root.left-data;
            tabs: root.left-tabs;
            segments: root.left-segments;
            rows: root.left-rows;
            active: root.active-panel == 0;
            split: root.split;
            address-editing: root.address-editing && self.active;
            address-text <=> root.address-text;
            filter-open: root.filter-open && self.active;
            filter-text <=> root.filter-text;
            filter-focus: root.filter-focus;
            search-open: root.search-open && self.active;
            search-text <=> root.search-text;
            search-focus: root.search-focus;
            search-content <=> root.search-content;
            search-regex <=> root.search-regex;
            search-names <=> root.search-names;
            search-problem: root.search-problem;
            search-mode-changed => {
                root.search-mode-changed();
            }
            editing: self.active ? root.editing : -1;
            edit-text <=> root.edit-text;
            edit-selection-start: root.edit-selection-start;
            edit-selection-end: root.edit-selection-end;
            edit-problem: root.edit-problem;
            edit-asking-extension: root.edit-asking-extension;
            notice: self.active ? root.notice : "";
            row-height: root.row-height;
            name-width <=> root.name-width;
            modified-width <=> root.modified-width;
            type-width <=> root.type-width;
            size-width <=> root.size-width;
            location-width <=> root.location-width;
            matches-width <=> root.matches-width;
            activate => {
                root.panel-pressed(0);
            }
            pointer(event) => {
                root.history-button(event);
            }
            focus-list => {
                root.focus-list();
            }
            focus-keys => {
                keys.focus();
            }
            row-pressed(row, ctrl, shift) => {
                root.row-pressed(row, ctrl, shift);
            }
            row-opened(row) => {
                root.row-opened(row);
            }
            row-middle-pressed(row) => {
                root.row-middle-pressed(row);
            }
            context-menu(row, x, y) => {
                root.context-menu(0, row, x, y);
            }
            tab-pressed(index) => {
                root.tab-pressed(index);
            }
            dragged-tab: root.left-dragged-tab;
            drop-slot: root.left-drop-slot;
            drop-row: root.left-drop-row;
            drop-tab: root.left-drop-tab;
            drop-segment: root.left-drop-segment;
            segment-geometry(i, x, w) => {
                root.segment-geometry(0, i, x, w);
            }
            marquee: root.left-marquee;
            marquee-press(row, ctrl, shift, x, y) => {
                root.marquee-press(0, row, ctrl, shift, x, y);
            }
            item-press(row, right, ctrl, shift, x, y) => {
                root.item-press(0, row, right, ctrl, shift, x, y);
            }
            tab-drag-start(index, x, y) => {
                root.tab-drag-start(0, index, x, y);
            }
            tab-drag-move(x, y) => {
                root.tab-drag-move(x, y);
            }
            tab-drag-end(x, y) => {
                root.tab-drag-end(x, y)
            }
            tab-drag-cancel => {
                root.tab-drag-cancel();
            }
            sort-by(column) => {
                root.sort-by(column);
            }
            confirm-rename(text) => {
                root.confirm-rename(text)
            }
            cancel-rename => {
                root.cancel-rename()
            }
            rename-edited(text) => {
                root.rename-edited(text);
            }
            answer-extension(yes) => {
                root.answer-extension(yes)
            }
            remove-selection(text, anchor, cursor) => {
                root.remove-selection(text, anchor, cursor)
            }
            segment-pressed(index) => {
                root.segment-pressed(index);
            }
            begin-address-edit => {
                root.begin-address-edit();
            }
            address-edited(text) => {
                root.address-edited(text);
            }
            address-step(step) => {
                root.address-step(step)
            }
            address-go(text) => {
                root.address-go(text)
            }
            cancel-address-edit => {
                root.cancel-address-edit();
            }
            filter-edited(text) => {
                root.filter-edited(text);
            }
            cancel-filter => {
                root.cancel-filter();
            }
            search-submit(text) => {
                root.search-submit(text);
            }
            cancel-search => {
                root.cancel-search();
            }
            stop-search => {
                root.stop-search();
            }
        }
        // 패널 사이 경계: 끌어 분할 비율을 바꾸고, 두 번 누르면 반반으로 맞춘다.
        if root.split: Rectangle {
            x: panels.left-width;
            width: panels.gap;
            height: parent.height;
            splitter := TouchArea {
                mouse-cursor: col-resize;
                moved => {
                    if (self.pressed && panels.width > panels.gap) {
                        root.split-dragged((panels.left-width + self.mouse-x - self.pressed-x) / (panels.width - panels.gap));
                    }
                }
                double-clicked => {
                    root.split-reset();
                }
            }
            Rectangle {
                x: (parent.width - 2px) / 2;
                width: 2px;
                background: splitter.has-hover || splitter.pressed ? Palette.accent-background : transparent;
            }
        }
        right := PanelView {
            x: panels.left-width + panels.gap;
            width: root.split ? parent.width - self.x : 0px;
            height: parent.height;
            visible: root.split;
            data: root.right-data;
            tabs: root.right-tabs;
            segments: root.right-segments;
            rows: root.right-rows;
            active: root.active-panel == 1;
            split: root.split;
            address-editing: root.address-editing && self.active;
            address-text <=> root.address-text;
            filter-open: root.filter-open && self.active;
            filter-text <=> root.filter-text;
            filter-focus: root.filter-focus;
            search-open: root.search-open && self.active;
            search-text <=> root.search-text;
            search-focus: root.search-focus;
            search-content <=> root.search-content;
            search-regex <=> root.search-regex;
            search-names <=> root.search-names;
            search-problem: root.search-problem;
            search-mode-changed => {
                root.search-mode-changed();
            }
            editing: self.active ? root.editing : -1;
            edit-text <=> root.edit-text;
            edit-selection-start: root.edit-selection-start;
            edit-selection-end: root.edit-selection-end;
            edit-problem: root.edit-problem;
            edit-asking-extension: root.edit-asking-extension;
            notice: self.active ? root.notice : "";
            row-height: root.row-height;
            name-width <=> root.name-width;
            modified-width <=> root.modified-width;
            type-width <=> root.type-width;
            size-width <=> root.size-width;
            location-width <=> root.location-width;
            matches-width <=> root.matches-width;
            activate => {
                root.panel-pressed(1);
            }
            pointer(event) => {
                root.history-button(event);
            }
            focus-list => {
                root.focus-list();
            }
            focus-keys => {
                keys.focus();
            }
            row-pressed(row, ctrl, shift) => {
                root.row-pressed(row, ctrl, shift);
            }
            row-opened(row) => {
                root.row-opened(row);
            }
            row-middle-pressed(row) => {
                root.row-middle-pressed(row);
            }
            context-menu(row, x, y) => {
                root.context-menu(1, row, x, y);
            }
            tab-pressed(index) => {
                root.tab-pressed(index);
            }
            dragged-tab: root.right-dragged-tab;
            drop-slot: root.right-drop-slot;
            drop-row: root.right-drop-row;
            drop-tab: root.right-drop-tab;
            drop-segment: root.right-drop-segment;
            segment-geometry(i, x, w) => {
                root.segment-geometry(1, i, x, w);
            }
            marquee: root.right-marquee;
            marquee-press(row, ctrl, shift, x, y) => {
                root.marquee-press(1, row, ctrl, shift, x, y);
            }
            item-press(row, right, ctrl, shift, x, y) => {
                root.item-press(1, row, right, ctrl, shift, x, y);
            }
            tab-drag-start(index, x, y) => {
                root.tab-drag-start(1, index, x, y);
            }
            tab-drag-move(x, y) => {
                root.tab-drag-move(x, y);
            }
            tab-drag-end(x, y) => {
                root.tab-drag-end(x, y)
            }
            tab-drag-cancel => {
                root.tab-drag-cancel();
            }
            sort-by(column) => {
                root.sort-by(column);
            }
            confirm-rename(text) => {
                root.confirm-rename(text)
            }
            cancel-rename => {
                root.cancel-rename()
            }
            rename-edited(text) => {
                root.rename-edited(text);
            }
            answer-extension(yes) => {
                root.answer-extension(yes)
            }
            remove-selection(text, anchor, cursor) => {
                root.remove-selection(text, anchor, cursor)
            }
            segment-pressed(index) => {
                root.segment-pressed(index);
            }
            begin-address-edit => {
                root.begin-address-edit();
            }
            address-edited(text) => {
                root.address-edited(text);
            }
            address-step(step) => {
                root.address-step(step)
            }
            address-go(text) => {
                root.address-go(text)
            }
            cancel-address-edit => {
                root.cancel-address-edit();
            }
            filter-edited(text) => {
                root.filter-edited(text);
            }
            cancel-filter => {
                root.cancel-filter();
            }
            search-submit(text) => {
                root.search-submit(text);
            }
            cancel-search => {
                root.cancel-search();
            }
            stop-search => {
                root.stop-search();
            }
        }
    }

    // 확인 줄: 반대편 패널로 복사·이동할 대상과 항목 수, 또는 영구 삭제 경고와 항목(하나면 이름, 여럿이면 수). 시작 전에
    // 막히면 그 까닭을 보인다.
    if root.confirm-open: Rectangle {
        x: 8px;
        y: parent.height - 8px - root.work-height - 32px;
        width: parent.width - 16px;
        height: 32px;
        border-radius: 4px;
        border-width: 1px;
        border-color: root.confirm-problem == TransferProblem.none && root.confirm-delete == DeleteConfirm.none ? Palette.accent-background : #c42b1c;
        background: root.confirm-problem == TransferProblem.none && root.confirm-delete == DeleteConfirm.none ? Palette.accent-background.transparentize(85%) : #fde7e9;
        TouchArea { }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            Text {
                text: root.confirm-problem == TransferProblem.none && root.confirm-delete == DeleteConfirm.permanent
                    ? (root.confirm-name != ""
                        ? @tr("「{}」을(를) 영구 삭제합니다. 실행취소할 수 없습니다. Enter로 삭제, Esc로 취소", root.confirm-name)
                        : @tr("{}개 항목을 영구 삭제합니다. 실행취소할 수 없습니다. Enter로 삭제, Esc로 취소", root.confirm-items))
                    : root.confirm-problem == TransferProblem.none && root.confirm-delete == DeleteConfirm.no-recycle-bin
                    ? (root.confirm-name != ""
                        ? @tr("휴지통이 없는 위치라 「{}」이(가) 영구 삭제되며 실행취소할 수 없습니다. Enter로 삭제, Esc로 취소", root.confirm-name)
                        : @tr("휴지통이 없는 위치라 {}개 항목이 영구 삭제되며 실행취소할 수 없습니다. Enter로 삭제, Esc로 취소", root.confirm-items))
                    : root.confirm-problem == TransferProblem.none
                    ? (root.confirm-moving
                        ? @tr("{}개 항목을 {}(으)로 이동합니다. Enter로 시작, Esc로 취소", root.confirm-items, root.confirm-target)
                        : @tr("{}개 항목을 {}(으)로 복사합니다. Enter로 시작, Esc로 취소", root.confirm-items, root.confirm-target))
                    : root.confirm-problem == TransferProblem.no-sources ? @tr("옮길 항목이 없습니다")
                    : root.confirm-problem == TransferProblem.target-missing ? @tr("대상 위치가 없습니다: {}", root.confirm-problem-path)
                    : root.confirm-problem == TransferProblem.target-not-folder ? @tr("대상이 폴더가 아닙니다: {}", root.confirm-problem-path)
                    : root.confirm-problem == TransferProblem.into-itself ? @tr("폴더를 그 폴더 자신으로 보낼 수 없습니다: {}", root.confirm-problem-path)
                    : root.confirm-problem == TransferProblem.nothing-to-delete ? @tr("지울 항목이 없습니다")
                    : @tr("대상 위치가 원본 폴더 안에 있습니다: {}", root.confirm-problem-path);
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
                color: root.confirm-problem == TransferProblem.none && root.confirm-delete == DeleteConfirm.none ? Palette.foreground : #c42b1c;
            }
            if root.confirm-problem == TransferProblem.none: VerticalLayout {
                alignment: center;
                SmallButton {
                    text: root.confirm-delete == DeleteConfirm.none ? @tr("시작") : @tr("삭제");
                    clicked => {
                        root.confirm-accept();
                        keys.focus();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                SmallButton {
                    text: root.confirm-problem == TransferProblem.none ? @tr("취소") : @tr("닫기");
                    clicked => {
                        root.confirm-cancel();
                        keys.focus();
                    }
                }
            }
        }
    }

    // 작업 영역: 창 아래쪽에 작업 대기열의 작업마다 진행 표시를 보인다. 세 개가 넘으면 넘겨 본다.
    if root.jobs.length > 0: Rectangle {
        x: 8px;
        y: parent.height - 8px - root.work-height + 4px;
        width: parent.width - 16px;
        height: root.work-height - 4px;
        ListView {
            for job in root.jobs: Rectangle {
                height: (job.ask == JobAsk.none ? root.job-height : root.job-height + root.question-height)
                    + (job.not-done == "" ? 0px : root.report-height);
                JobView {
                    y: 0px;
                    height: parent.height - 4px;
                    job: job;
                    // 다른 입력(이름 입력란, 주소창, 팔레트, 확인 줄, 정보 화면)이 열려 있으면 키보드를 뺏지 않는다.
                    autofocus: root.editing < 0 && !root.address-editing && !root.filter-open && !root.search-open && !root.palette-open && !root.target-open && !root.confirm-open && !root.show-about && !root.history-open && !root.menu-open;
                    answer-conflict(choice, rest) => {
                        root.job-answer-conflict(job.id, choice, rest);
                        keys.focus();
                    }
                    answer-error(choice) => {
                        root.job-answer-error(job.id, choice);
                        keys.focus();
                    }
                    answer-not-recyclable(choice) => {
                        root.job-answer-not-recyclable(job.id, choice);
                        keys.focus();
                    }
                    leave => {
                        keys.focus();
                    }
                    pause => {
                        root.job-pause(job.id);
                        keys.focus();
                    }
                    resume => {
                        root.job-resume(job.id);
                        keys.focus();
                    }
                    cancel => {
                        root.job-cancel(job.id);
                        keys.focus();
                    }
                    start-now => {
                        root.job-start-now(job.id);
                        keys.focus();
                    }
                    dismiss => {
                        root.job-dismiss(job.id);
                        keys.focus();
                    }
                }
            }
        }
    }

    // 주소창 자동 완성 후보. 목록 위에 겹쳐 그리도록 창 전체를 덮는 층에 두고 주소창 바로 아래에 놓는다.
    Rectangle {
        Rectangle {
            visible: root.address-editing && root.candidates.length > 0;
            x: (root.active-panel == 1 ? right.address-x : left.address-x) - parent.absolute-position.x;
            y: (root.active-panel == 1 ? right.address-y : left.address-y) - parent.absolute-position.y;
            width: root.active-panel == 1 ? right.address-width : left.address-width;
            height: min(root.candidates.length, 10) * root.candidate-row-height + 2px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 6px;
            drop-shadow-color: #00000040;
            candidate-list := ListView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                for candidate[i] in root.candidates: Rectangle {
                    height: root.candidate-row-height;
                    background: i == root.candidate-highlight ? Palette.selection-background
                        : candidate-touch.has-hover ? Palette.alternate-background : transparent;
                    candidate-touch := TouchArea {
                        clicked => {
                            root.candidate-pressed(i);
                            keys.focus();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            ItemIcon {
                                folder: true;
                            }
                        }
                        Text {
                            text: candidate;
                            overflow: elide;
                            vertical-alignment: center;
                            color: i == root.candidate-highlight ? Palette.selection-foreground : Palette.foreground;
                        }
                    }
                }
            }
        }
    }

    // 명령 팔레트: 창 위에 겹쳐 그린다. 입력란에서 검색하고 화살표·Enter·Esc로 다룬다.
    if root.palette-open: Rectangle {
        background: #00000040;
        TouchArea {
            clicked => {
                keys.focus();
                root.palette-close();
            }
        }
        Rectangle {
            y: 48px;
            width: min(parent.width - 32px, 520px);
            height: 44px + max(min(root.palette-rows.length, 10), 1) * 28px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000060;
            TouchArea { }
            Rectangle {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: 28px;
                border-width: 1px;
                border-color: Palette.accent-background;
                clip: true;
                palette-input := TextInput {
                    x: 6px;
                    width: parent.width - 12px;
                    single-line: true;
                    vertical-alignment: center;
                    color: Palette.foreground;
                    text <=> root.palette-text;
                    init => {
                        self.focus();
                        self.select-all();
                    }
                    edited => {
                        root.palette-edited(self.text);
                    }
                    accepted => {
                        keys.focus();
                        if (!root.palette-run(root.palette-highlight)) {
                            self.focus();
                        }
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            keys.focus();
                            root.palette-close();
                            return accept;
                        }
                        if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                            root.palette-step(event.text == Key.UpArrow ? -1 : 1);
                            return accept;
                        }
                        reject
                    }
                }
            }
            if root.palette-rows.length == 0: Text {
                x: 14px;
                y: 44px;
                height: 28px;
                text: @tr("일치하는 명령이 없습니다");
                vertical-alignment: center;
                color: Palette.foreground.transparentize(40%);
            }
            ListView {
                x: 1px;
                y: 44px;
                width: parent.width - 2px;
                height: min(root.palette-rows.length, 10) * 28px;
                for entry[i] in root.palette-rows: Rectangle {
                    height: 28px;
                    background: i == root.palette-highlight ? Palette.selection-background
                        : entry-touch.has-hover ? Palette.alternate-background : transparent;
                    entry-touch := TouchArea {
                        clicked => {
                            keys.focus();
                            if (!root.palette-run(i)) {
                                palette-input.focus();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        Text {
                            text: entry.name;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: (i == root.palette-highlight ? Palette.selection-foreground : Palette.foreground)
                                .transparentize(entry.enabled ? 0% : 55%);
                        }
                        Text {
                            text: entry.shortcut;
                            vertical-alignment: center;
                            color: (i == root.palette-highlight ? Palette.selection-foreground : Palette.foreground)
                                .transparentize(entry.enabled ? 30% : 65%);
                        }
                    }
                }
            }
        }
    }

    // 복사·이동 대상 선택 창: 창 위에 겹쳐 그린다. 입력란에 경로를 치면 하위 폴더 후보가 뜨고, 비어 있으면 반대편 패널
    // 위치와 최근 대상을 보인다. ↑↓·Tab으로 고르고 Enter로 확정, Esc로 닫는다.
    if root.target-open: Rectangle {
        background: #00000040;
        TouchArea {
            clicked => {
                keys.focus();
                root.target-cancel();
            }
        }
        Rectangle {
            y: 48px;
            width: min(parent.width - 32px, 560px);
            height: 74px + (root.target-has-problem ? 24px : 0px) + min(root.target-rows.length, 11) * 28px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000060;
            TouchArea { }
            Text {
                x: 12px;
                y: 8px;
                width: parent.width - 24px;
                height: 20px;
                overflow: elide;
                vertical-alignment: center;
                text: root.target-moving
                    ? @tr("{}개 항목을 이동할 폴더를 고르세요", root.target-items)
                    : @tr("{}개 항목을 복사할 폴더를 고르세요", root.target-items);
            }
            Rectangle {
                x: 8px;
                y: 34px;
                width: parent.width - 16px;
                height: 28px;
                border-width: 1px;
                border-color: root.target-has-problem ? #c42b1c : Palette.accent-background;
                clip: true;
                target-input := TextInput {
                    x: 6px;
                    width: parent.width - 12px;
                    single-line: true;
                    vertical-alignment: center;
                    color: Palette.foreground;
                    text <=> root.target-text;
                    init => {
                        self.focus();
                        self.select-all();
                    }
                    edited => {
                        root.target-edited(self.text);
                    }
                    accepted => {
                        if (root.target-accept(self.text)) {
                            keys.focus();
                        }
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            keys.focus();
                            root.target-cancel();
                            return accept;
                        }
                        if (event.text == Key.Tab || event.text == Key.Backtab || event.text == Key.DownArrow
                            || event.text == Key.UpArrow) {
                            let backward = event.text == Key.Backtab || event.text == Key.UpArrow
                                || (event.text == Key.Tab && event.modifiers.shift);
                            let end = root.target-step(backward ? -1 : 1);
                            if (end >= 0) {
                                self.set-selection-offsets(end, end);
                            }
                            return accept;
                        }
                        reject
                    }
                }
            }
            if root.target-has-problem: Text {
                x: 12px;
                y: 64px;
                width: parent.width - 24px;
                height: 24px;
                overflow: elide;
                vertical-alignment: center;
                color: #c42b1c;
                text: root.target-problem == Problem.address-empty ? @tr("주소를 입력하세요")
                    : root.target-problem == Problem.address-invalid-character ? @tr("주소에 쓸 수 없는 글자가 있습니다: {}", root.target-problem-value)
                    : root.target-problem == Problem.address-undefined-variable ? @tr("환경 변수가 없습니다: {}", root.target-problem-value)
                    : root.target-problem == Problem.address-not-absolute ? @tr("전체 경로가 아닙니다: {}", root.target-problem-value)
                    : root.target-problem == Problem.address-not-found ? @tr("위치가 없습니다: {}", root.target-problem-value)
                    : root.target-problem == Problem.address-permission-denied ? @tr("위치를 확인할 권한이 없습니다: {}", root.target-problem-value)
                    : root.target-problem == Problem.address-io ? @tr("위치를 확인하지 못했습니다: {}: {}", root.target-problem-value, root.target-problem-detail)
                    : root.target-problem == Problem.not-a-folder ? @tr("폴더가 아닙니다: {}", root.target-problem-value)
                    : root.target-transfer-problem == TransferProblem.no-sources ? @tr("옮길 항목이 없습니다")
                    : root.target-transfer-problem == TransferProblem.target-missing ? @tr("대상 위치가 없습니다: {}", root.target-transfer-problem-path)
                    : root.target-transfer-problem == TransferProblem.target-not-folder ? @tr("대상이 폴더가 아닙니다: {}", root.target-transfer-problem-path)
                    : root.target-transfer-problem == TransferProblem.into-itself ? @tr("폴더를 그 폴더 자신으로 보낼 수 없습니다: {}", root.target-transfer-problem-path)
                    : @tr("대상 위치가 원본 폴더 안에 있습니다: {}", root.target-transfer-problem-path);
            }
            ListView {
                x: 1px;
                y: 70px + (root.target-has-problem ? 24px : 0px);
                width: parent.width - 2px;
                height: min(root.target-rows.length, 11) * 28px;
                for entry[i] in root.target-rows: Rectangle {
                    height: 28px;
                    background: i == root.target-highlight ? Palette.selection-background
                        : target-entry-touch.has-hover ? Palette.alternate-background : transparent;
                    target-entry-touch := TouchArea {
                        clicked => {
                            keys.focus();
                            if (!root.target-row-pressed(i)) {
                                target-input.focus();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        Text {
                            text: entry.path;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: i == root.target-highlight ? Palette.selection-foreground : Palette.foreground;
                        }
                        Text {
                            text: entry.section == TargetSection.opposite ? @tr("반대편 패널")
                                : entry.section == TargetSection.recent ? @tr("최근") : "";
                            vertical-alignment: center;
                            color: (i == root.target-highlight ? Palette.selection-foreground : Palette.foreground)
                                .transparentize(30%);
                        }
                    }
                }
            }
        }
    }

    // 작업 기록 보기: 창 위에 겹쳐 그리는 읽기 전용 목록. 키보드는 키 입력란에 남아 Esc로 닫는다.
    if root.history-open: Rectangle {
        background: #00000040;
        TouchArea {
            clicked => {
                root.history-close();
                keys.focus();
            }
        }
        Rectangle {
            y: 48px;
            width: min(parent.width - 32px, 560px);
            height: min(parent.height - 96px, 44px + max(root.history-rows.length, 1) * 44px);
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000060;
            TouchArea { }
            Text {
                x: 14px;
                y: 8px;
                height: 28px;
                text: @tr("작업 기록");
                font-weight: 700;
                vertical-alignment: center;
            }
            if root.history-rows.length == 0: Text {
                x: 14px;
                y: 44px;
                height: 28px;
                text: @tr("끝난 작업이 없습니다");
                vertical-alignment: center;
                color: Palette.foreground.transparentize(40%);
            }
            ListView {
                x: 0px;
                y: 40px;
                width: parent.width;
                height: parent.height - 44px;
                for row in root.history-rows: Rectangle {
                    height: 44px;
                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        Text {
                            text: row.name;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 14px;
                            Text {
                                text: @tr("끝낸 항목 {} · 건너뛴 항목 {}", row.completed, row.skipped);
                                color: Palette.foreground.transparentize(40%);
                            }
                            Text {
                                text: row.not-undoable == "" ? @tr("되돌릴 수 있음") : row.not-undoable;
                                horizontal-stretch: 1;
                                overflow: elide;
                                color: row.not-undoable == "" ? Palette.foreground.transparentize(40%) : #c42b1c;
                            }
                        }
                    }
                }
            }
        }
    }

    // 오른쪽 메뉴: 창 위에 직접 그린다. 키보드는 키 입력란에 남고, 바깥 누르기로 닫는다.
    if root.menu-open: Rectangle {
        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.menu-close();
                    keys.focus();
                }
            }
        }
        ContextMenuView {
            x: root.menu-x;
            y: root.menu-y;
            width: root.menu-width;
            height: root.menu-height;
            rows: root.menu-rows;
            selected: root.menu-selected;
            hover(i) => {
                root.menu-hover(false, i);
            }
            activate(i) => {
                root.menu-activate(false, i);
                keys.focus();
            }
        }
        if root.menu-sub-open: ContextMenuView {
            x: root.menu-sub-x;
            y: root.menu-sub-y;
            width: root.menu-sub-width;
            height: root.menu-sub-height;
            rows: root.menu-sub-rows;
            selected: root.menu-sub-selected;
            hover(i) => {
                root.menu-hover(true, i);
            }
            activate(i) => {
                root.menu-activate(true, i);
                keys.focus();
            }
        }
    }

    // 정보 화면: Slint 로열티 프리 라이선스의 표시 의무(ADR-0002)로 AboutSlint를 보인다.
    if root.show-about: Rectangle {
        background: #00000080;
        TouchArea { }
        Rectangle {
            width: 360px;
            height: 320px;
            background: Palette.background;
            border-radius: 8px;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: "facet";
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("Windows 파일 탐색기를 대체하는 앱");
                    horizontal-alignment: center;
                }
                AboutSlint { }
                HorizontalLayout {
                    alignment: center;
                    Button {
                        text: @tr("닫기");
                        clicked => {
                            root.show-about = false;
                            keys.focus();
                        }
                    }
                }
            }
        }
    }
}

// 진행 창: 보통 창을 모두 닫았는데 작업 대기열에 끝나지 않은 작업이 남아 있으면 이 창만 남는다. 작업 영역과 같은
// 진행 표시·단추·질문 대화를 보인다. 작업이 모두 끝나면 Rust가 닫고 프로세스가 끝난다. 사용자가 닫으려 하면
// 닫지 않고(작업을 몰래 잃지 않는다) 까닭을 강조한다: 그만두려면 작업마다 취소한다.
export component ProgressWindow inherits Window {
    title: @tr("작업 진행 - facet");
    preferred-width: 640px;
    preferred-height: 300px;
    min-width: 360px;
    min-height: 160px;
    default-font-size: 13px;

    in property <[JobRow]> jobs;
    out property <length> job-height: 56px;
    out property <length> question-height: 120px;
    out property <length> report-height: 18px;
    // 사용자가 닫기 단추를 눌렀다: 닫지 않은 까닭을 강조한다.
    in property <bool> close-refused;

    callback new-window();
    // 키(글자와 수식 키). Ctrl+N 같은 새 창 단축키를 Rust가 코어 명령으로 찾는다. 받았으면 `true`.
    callback key(string, bool, bool, bool) -> bool;
    callback job-pause(int);
    callback job-resume(int);
    callback job-cancel(int);
    callback job-start-now(int);
    callback job-dismiss(int);
    callback job-answer-conflict(int, ConflictChoice, bool);
    callback job-answer-error(int, ErrorChoice);
    callback job-answer-not-recyclable(int, NotRecyclableChoice);

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (root.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift)) {
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: @tr("창을 모두 닫았지만 작업이 끝날 때까지 이 창이 남습니다. 작업이 모두 끝나면 저절로 닫히고 facet이 끝납니다.");
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    SmallButton {
                        text: @tr("새 창");
                        clicked => {
                            root.new-window();
                        }
                    }
                }
            }
            if root.close-refused: Text {
                text: @tr("작업이 남아 있어 닫지 않았습니다. 그만두려면 작업을 취소하세요.");
                wrap: word-wrap;
                color: #c42b1c;
            }
            ListView {
                vertical-stretch: 1;
                for job in root.jobs: Rectangle {
                    height: (job.ask == JobAsk.none ? root.job-height : root.job-height + root.question-height)
                        + (job.not-done == "" ? 0px : root.report-height);
                    JobView {
                        y: 0px;
                        height: parent.height - 4px;
                        job: job;
                        // 이 창에는 다른 입력이 없으므로 질문 대화가 생기면 키보드를 가져간다.
                        autofocus: true;
                        answer-conflict(choice, rest) => {
                            root.job-answer-conflict(job.id, choice, rest);
                            keys.focus();
                        }
                        answer-error(choice) => {
                            root.job-answer-error(job.id, choice);
                            keys.focus();
                        }
                        answer-not-recyclable(choice) => {
                            root.job-answer-not-recyclable(job.id, choice);
                            keys.focus();
                        }
                        leave => {
                            keys.focus();
                        }
                        pause => {
                            root.job-pause(job.id);
                        }
                        resume => {
                            root.job-resume(job.id);
                        }
                        cancel => {
                            root.job-cancel(job.id);
                        }
                        start-now => {
                            root.job-start-now(job.id);
                        }
                        dismiss => {
                            root.job-dismiss(job.id);
                        }
                    }
                }
            }
        }
    }
}
